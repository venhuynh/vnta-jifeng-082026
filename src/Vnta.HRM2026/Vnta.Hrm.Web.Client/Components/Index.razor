@page "/"
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject NavigationManager NavigationManager

@code {
    private const string DefaultAuthenticatedRoute = "/implementation/progress";

    bool HasRedirected { get; set; }

    protected override void OnAfterRender(bool firstRender) {
        if(!firstRender || HasRedirected) {
            return;
        }

        HasRedirected = true;
        NavigationManager.NavigateTo(DefaultAuthenticatedRoute, replace: true);
    }
}
