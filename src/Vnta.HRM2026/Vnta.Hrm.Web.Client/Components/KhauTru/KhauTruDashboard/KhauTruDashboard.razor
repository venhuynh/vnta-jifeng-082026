@page "/payroll/deduction-dashboard"

@using DevExpress.Blazor
@using Microsoft.AspNetCore.Authorization
@using Vnta.Hrm.Application.KhauTru.KhauTruTongHop

@attribute [Authorize(Policy = InternalAccountPolicies.PayrollAdministration)]
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>VNTA - Dashboard khấu trừ</PageTitle>

<DxLayoutBreakpoint MaxWidth="1400" IsActiveChanged="OnSmallScreenChanged" />
<DxLayoutBreakpoint MinWidth="1400" MaxWidth="2000" @bind-IsActive="IsMediumScreen" />
<DxLayoutBreakpoint MinWidth="2000" @bind-IsActive="IsLargeScreen" />

<div class="content-root">
    <div class="card toolbar">
        <DxToolbar Title="Dashboard khấu trừ" CssClass="toolbar" ItemRenderStyleMode="ToolbarRenderStyleMode.Plain">
            <DxToolbarItem Alignment="ToolbarItemAlignment.Right" CssClass="toolbar-filter-item">
                <Template>
                    <div class="custom-item toolbar-filter-editor">
                        <span class="toolbar-filter-label">Năm</span>
                        <DxSpinEdit T="int" Value="@ToolbarYear" ValueChanged="OnYearChangedAsync" MinValue="@MinimumSupportedYear" MaxValue="@MaximumSupportedYear" Increment="1" ShowSpinButtons="true" Enabled="@CanChangePeriod" CssClass="toolbar-filter-year" />
                    </div>
                </Template>
            </DxToolbarItem>
            <DxToolbarItem Alignment="ToolbarItemAlignment.Right" CssClass="toolbar-filter-item">
                <Template>
                    <div class="custom-item toolbar-filter-editor">
                        <span class="toolbar-filter-label">Tháng</span>
                        <DxComboBox TData="MonthOption" TValue="int" @key="ToolbarYear" Data="@AvailableMonths" Value="@ToolbarMonth" ValueChanged="OnMonthChangedAsync" ValueFieldName="@nameof(MonthOption.Value)" TextFieldName="@nameof(MonthOption.Text)" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never" Enabled="@CanChangePeriod" CssClass="toolbar-filter-month" />
                    </div>
                </Template>
            </DxToolbarItem>
            <DxToolbarItem Text="Xem"
                           Click="LoadDashboardAsync"
                           Enabled="@CanChangePeriod"
                           Alignment="ToolbarItemAlignment.Right"
                           Tooltip="Xem dữ liệu dashboard khấu trừ theo kỳ lương đang chọn"
                           IconUrl="@VntaDevExpressIcons.FolderOpenArrowImport" />
        </DxToolbar>
    </div>

    <div class="deduction-dashboard-root">
        @if(!string.IsNullOrWhiteSpace(LoadErrorMessage))
        {
            <div class="card error-state">
                <div class="state-title">Không thể tải dashboard khấu trừ</div>
                <div class="state-message">@LoadErrorMessage</div>
                <DxButton Text="Thử lại" Click="LoadDashboardAsync" RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ButtonRenderStyleMode.Contained" />
            </div>
        }
        else
        {
            <div class="card deduction-dashboard-content-card">
                <HrmLoadingPanel Visible="@IsLoading" IsContentBlocked="true" IsContentVisible="true" IndicatorVisible="true" IndicatorAreaVisible="true" CssClass="deduction-dashboard-loading-panel" Text="Đang tải dashboard khấu trừ...">
                    @if(Dashboard is not null)
                    {
                        <div class="deduction-dashboard-content">
                            <div class="deduction-dashboard-kpi-strip">
                                <DashboardMetric Title="Tổng khấu trừ" Value="@FormatMoney(Dashboard.Overview.TotalDeductionAmount)" Detail="@GetMoneyChangeText()" Trend="@GetMoneyChangeRatio()" />
                                <DashboardMetric Title="Bản ghi khấu trừ" Value="@Dashboard.Overview.TotalCount.ToString("N0")" Detail="@GetCountChangeText()" Trend="@GetCountChangeRatio()" />
                                <DashboardMetric Title="Tỷ lệ đã khóa" Value="@DashboardLockRateDisplay" Detail="@($"{Dashboard.Overview.LockedCount:N0} / {Dashboard.Overview.TotalCount:N0} bản ghi")" Trend="@DashboardLockRate" />
                                <DashboardMetric Title="Bình quân / bản ghi" Value="@FormatMoney(AverageDeduction)" Detail="@PeriodLabel" Trend="0" />
                            </div>

                            <DxGridLayout CssClass="deduction-dashboard-grid" RowSpacing="1.25rem" ColumnSpacing="1.5rem">
                                <Rows>
                                    @if(IsLargeScreen)
                                    {
                                        <DxGridLayoutRow Areas="trend trend breakdown breakdown" Height="auto" />
                                        <DxGridLayoutRow Areas="comparison comparison comparison comparison" Height="auto" />
                                        <DxGridLayoutRow Areas="departments departments departments departments" Height="auto" />
                                    }
                                    else if(IsMediumScreen)
                                    {
                                        <DxGridLayoutRow Areas="trend trend" Height="auto" />
                                        <DxGridLayoutRow Areas="breakdown comparison" Height="auto" />
                                        <DxGridLayoutRow Areas="departments departments" Height="auto" />
                                    }
                                    else
                                    {
                                        <DxGridLayoutRow Areas="trend" Height="auto" />
                                        <DxGridLayoutRow Areas="breakdown" Height="auto" />
                                        <DxGridLayoutRow Areas="comparison" Height="auto" />
                                        <DxGridLayoutRow Areas="departments" Height="auto" />
                                    }
                                </Rows>
                                <Columns>
                                    @if(IsLargeScreen)
                                    {
                                        <DxGridLayoutColumn /><DxGridLayoutColumn /><DxGridLayoutColumn /><DxGridLayoutColumn />
                                    }
                                    else if(IsMediumScreen)
                                    {
                                        <DxGridLayoutColumn /><DxGridLayoutColumn />
                                    }
                                    else
                                    {
                                        <DxGridLayoutColumn />
                                    }
                                </Columns>
                                <Items>
                                    <DxGridLayoutItem Area="trend" CssClass="dashboard-section">
                                        <Template><KhauTruDashboardTrendReport Trend="@Dashboard.Trend" PayrollMonth="@Dashboard.PayrollMonth" PayrollYear="@Dashboard.PayrollYear" IsRefreshing="@IsLoading" RefreshRequested="LoadDashboardAsync" /></Template>
                                    </DxGridLayoutItem>
                                    <DxGridLayoutItem Area="breakdown" CssClass="dashboard-section">
                                        <Template><KhauTruDashboardBreakdownReport Breakdown="@Dashboard.DeductionBreakdown" IsRefreshing="@IsLoading" RefreshRequested="LoadDashboardAsync" /></Template>
                                    </DxGridLayoutItem>
                                    <DxGridLayoutItem Area="departments" CssClass="dashboard-section">
                                        <Template><KhauTruDashboardDepartmentComparisonReport Comparison="@Dashboard.DepartmentMonthlyComparison" PayrollMonth="@Dashboard.PayrollMonth" PayrollYear="@Dashboard.PayrollYear" IsRefreshing="@IsLoading" RefreshRequested="LoadDashboardAsync" /></Template>
                                    </DxGridLayoutItem>
                                    <DxGridLayoutItem Area="comparison" CssClass="dashboard-section">
                                        <Template><KhauTruDashboardMonthlyComparisonReport Comparison="@Dashboard.DeductionMonthlyComparison" PayrollMonth="@Dashboard.PayrollMonth" PayrollYear="@Dashboard.PayrollYear" IsRefreshing="@IsLoading" RefreshRequested="LoadDashboardAsync" /></Template>
                                    </DxGridLayoutItem>
                                </Items>
                            </DxGridLayout>
                        </div>
                    }
                </HrmLoadingPanel>
            </div>
        }
    </div>
</div>
