@using DevExpress.Blazor
@using Vnta.Hrm.Application.KhauTru.KhauTruTongHop

<div class="dashboard-report">
    <div class="dashboard-section-header">
        <div>
            <div class="dashboard-section-title">Xu hướng tổng khấu trừ</div>
            <div class="dashboard-subtitle">Tổng khấu trừ từ tháng 01 đến @PeriodLabel</div>
        </div>
        <DxButton IconUrl="@VntaDevExpressIcons.Refresh" Click="RefreshRequested" Enabled="@(!IsRefreshing)" Tooltip="Tải lại dashboard khấu trừ" CssClass="dashboard-report-refresh" />
    </div>
    @if(Trend.Count == 0)
    {
        <div class="dashboard-report-message">Chưa có dữ liệu xu hướng khấu trừ cho kỳ đã chọn.</div>
    }
    else
    {
        <DxChart Data="@Trend" CssClass="deduction-chart">
            <DxChartLineSeries T="PayrollDeductionDashboardTrendPointDto"
            TArgument="string"
            TValue="double"
            ArgumentField="point => FormatPeriod(point.PayrollMonth, point.PayrollYear)"
            ValueField="point => (double)point.TotalDeductionAmount"
                Name="Tổng khấu trừ" HoverMode="ChartContinuousSeriesHoverMode.None">
                <DxChartSeriesPoint Visible="true" Size="9" />
                <DxChartSeriesLabel Visible="true"
                                    FormatPattern="{valueText} đ"
                                    ValueFormat="MoneyLabelFormat" />
            </DxChartLineSeries>
            <DxChartLegend Visible="false" />
            <DxChartTooltip Enabled="true">
                @context.Point.Render((seriesPoint) => @<div class="dashboard-trend-tooltip">
                    <div class="dashboard-trend-tooltip-period">@seriesPoint.Argument</div>
                    <div class="dashboard-trend-tooltip-value">@FormatMoney(Convert.ToDouble(seriesPoint.Value))</div>
                </div>)
            </DxChartTooltip>
        </DxChart>
    }
</div>
