@page "/payroll/other-deductions"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Policy = InternalAccountPolicies.PayrollAdministration)]
@rendermode InteractiveServer

<PageTitle>VNTA - Khấu trừ khác</PageTitle>

<div class="content-root">
    <div class="card toolbar">
        <DxToolbar Title="Khấu trừ khác"
                   CssClass="toolbar"
                   ItemRenderStyleMode="ToolbarRenderStyleMode.Plain">
            <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                           CssClass="toolbar-filter-item"
                           Tooltip="Chọn năm áp dụng">
                <Template>
                    <div class="custom-item toolbar-filter-editor">
                        <span class="toolbar-filter-label">Năm</span>
                        <DxSpinEdit T="int"
                                    Value="@ToolbarYear"
                                    ValueChanged="OnSelectedYearChangedAsync"
                                    MinValue="@MinimumSupportedYear"
                                    MaxValue="@MaximumSupportedYear"
                                    Increment="1"
                                    ShowSpinButtons="true"
                                    Enabled="@CanChangeFilters"
                                    CssClass="toolbar-filter-year" />
                    </div>
                </Template>
            </DxToolbarItem>
            <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                           CssClass="toolbar-filter-item"
                           Tooltip="Chọn tháng áp dụng">
                <Template>
                    <div class="custom-item toolbar-filter-editor">
                        <span class="toolbar-filter-label">Tháng</span>
                        <DxComboBox TData="MonthOption"
                                    TValue="int"
                                    @key="ToolbarYear"
                                    Data="@AvailableMonthOptions"
                                    Value="@ToolbarMonth"
                                    ValueChanged="OnSelectedMonthChangedAsync"
                                    ValueFieldName="@nameof(MonthOption.Value)"
                                    TextFieldName="@nameof(MonthOption.Text)"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    Enabled="@CanChangeFilters"
                                    CssClass="toolbar-filter-month" />
                    </div>
                </Template>
            </DxToolbarItem>
            <DxToolbarItem Text="Xem"
                           Click="OnViewRequestedAsync"
                           Enabled="@CanView"
                           Alignment="ToolbarItemAlignment.Right"
                           Tooltip="Chuẩn bị và tải dữ liệu khấu trừ khác theo kỳ lương đang chọn"
                           IconUrl="@VntaDevExpressIcons.FolderOpenArrowImport" />
            <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                           Tooltip="Nhóm các hành động thao tác trên dữ liệu khấu trừ khác">
                <Template>
                    <div class="custom-item">
                        <DxDropDownButton Text="Hành động"
                                          IconUrl="@VntaDevExpressIcons.TaskList"
                                          RenderStyle="ButtonRenderStyle.Secondary"
                                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                                          Enabled="@CanOperateOnCurrentDataset"
                                          CssClass="toolbar-action-dropdown">
                            <Items>
                                <DxDropDownButtonItem Text="Tính lại"
                                                      IconUrl="@VntaDevExpressIcons.CalculatorCoins"
                                                      Click="OnRecalculateClickAsync"
                                                      Enabled="@CanRecalculate" />
                                <DxDropDownButtonItem Text="Khóa"
                                                      IconUrl="@VntaDevExpressIcons.Lock"
                                                      Click="OnLockSelectedAsync"
                                                      Enabled="@CanOpenLockAction"
                                                      BeginGroup="true" />
                                <DxDropDownButtonItem Text="Mở khóa"
                                                      IconUrl="@VntaDevExpressIcons.Unlock"
                                                      Click="OnUnlockSelectedAsync"
                                                      Enabled="@CanOpenUnlockAction" />
                            </Items>
                        </DxDropDownButton>
                    </div>
                </Template>
            </DxToolbarItem>
            <DxToolbarItem Text="Thông tin"
                           Click="OpenRulesPopup"
                           Enabled="@CanInteract"
                           Alignment="ToolbarItemAlignment.Right"
                           Tooltip="Xem thông tin khấu trừ khác"
                           IconUrl="@VntaDevExpressIcons.TextBoxDescription" />
            <DxToolbarItem Text="Xuất file"
                           Enabled="@CanExport"
                           Alignment="ToolbarItemAlignment.Right"
                           Tooltip="Xuất toàn bộ dữ liệu khấu trừ khác của kỳ lương đang chọn"
                           IconUrl="@VntaDevExpressIcons.Export">
                <Items>
                    <DxToolbarItem Text="Xuất Excel"
                                   Click="ExportAllDataToExcelAsync"
                                   Enabled="@CanExport"
                                   Tooltip="Xuất toàn bộ dữ liệu khấu trừ khác của kỳ lương đang chọn ra Excel"
                                   IconUrl="@VntaDevExpressIcons.Excel" />
                    <DxToolbarItem Text="Xuất PDF"
                                   Click="ExportAllDataToPdfAsync"
                                   Enabled="@CanExport"
                                   Tooltip="Xuất toàn bộ dữ liệu khấu trừ khác của kỳ lương đang chọn ra PDF"
                                   IconUrl="@VntaDevExpressIcons.Pdf" />
                </Items>
            </DxToolbarItem>
            <DxToolbarItem Tooltip="Chọn cột hiển thị trong danh sách khấu trừ khác"
                           Alignment="ToolbarItemAlignment.Right"
                           Enabled="@CanOperateOnCurrentDataset"
                           Click="OnColumnChooserRequested"
                           IconUrl="@VntaDevExpressIcons.ColumnChooser" />
        </DxToolbar>
    </div>

    <div class="other-deduction-root">
        @if (HasLoadError)
        {
            <div class="card error-state">
                <div class="state-title">Không thể tải dữ liệu khấu trừ khác</div>
                <div class="state-message">@LoadErrorMessage</div>
                <DxButton Text="Thử lại"
                          Click="OnRetryAsync"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained" />
            </div>
        }
        else
        {
            <div class="card other-deduction-grid-card">
                <HrmLoadingPanel Visible="@ShowLoadingPanel"
                                 IsContentBlocked="true"
                                 IsContentVisible="true"
                                 IndicatorVisible="true"
                                 IndicatorAreaVisible="true"
                                 Text="@LoadingText"
                                 CssClass="other-deduction-loading-panel">
                    <div class="other-deduction-grid-content">
                        <div class="other-deduction-grid-header">
                            <div class="other-deduction-summary-strip">
                                <DxButtonGroup CssClass="other-deduction-total-amount-button-group"
                                               RenderStyle="ButtonRenderStyle.Primary"
                                               RenderStyleMode="ButtonRenderStyleMode.Outline">
                                    <Items>
                                        <DxButtonGroupItem Text="@($"Tổng: {FormatCurrency(VisibleDeductionTotal)}")"
                                                           CssClass="other-deduction-total-amount-button" />
                                    </Items>
                                </DxButtonGroup>
                            </div>
                            <div class="other-deduction-grid-search">
                                <DxSearchBox CssClass="other-deduction-grid-searchbox"
                                             NullText="Tìm kiếm mã nhân viên, họ tên, bộ phận, chức vụ"
                                             BindValueMode="BindValueMode.OnDelayedInput"
                                             InputDelay="400"
                                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                             Text="@SearchText"
                                             TextChanged="OnSearchTextChanged"
                                             Enabled="@CanChangeFilters" />
                            </div>
                        </div>

                        <DxGrid @ref="Grid"
                                Data="@VisibleRecords"
                                KeyFieldName="Id"
                                CssClass="other-deduction-grid"
                                ShowSearchBox="false"
                                 PageSize="@PageSize"
                                 PageSizeChanged="OnPageSizeChanged"
                                 PagerPosition="GridPagerPosition.Bottom"
                                 PagerSummaryVisible="true"
                                 PageSizeSelectorVisible="true"
                                PageSizeSelectorItems="@(new int[] { 50, 100, 200 })"
                                PageSizeSelectorAllRowsItemVisible="false"
                                SkeletonRowsEnabled="true"
                                ColumnResizeMode="GridColumnResizeMode.NextColumn"
                                FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
                                TextWrapEnabled="false"
                                FocusedRowEnabled="true"
                                HighlightRowOnHover="true"
                                AllowSelectRowByClick="true"
                                 SelectionMode="GridSelectionMode.Multiple"
                                 SelectedDataItems="@SelectedDataItems"
                                 SelectedDataItemsChanged="@OnSelectedDataItemsChanged"
                                 FilterCriteriaChanged="OnGridFilterCriteriaChangedAsync">
                            <Columns>
                                <DxGridSelectionColumn Width="3rem" />
                                <DxGridDataColumn Caption="STT" Width="4.5rem" MinWidth="72" AllowSort="false">
                                    <CellDisplayTemplate>
                                        @(context.VisibleIndex + 1)
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="Tác vụ"
                                                  MinWidth="96"
                                                  Width="6rem"
                                                  AllowSort="false"
                                                  TextAlignment="GridTextAlignment.Center"
                                                  ShowInColumnChooser="false">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (KhauTruKhacRecord)context.DataItem;
                                        }
                                        <div class="other-deduction-row-menu-host"
                                             @onclick:stopPropagation="true"
                                             @onmousedown:stopPropagation="true">
                                            <DxDropDownButton CssClass="other-deduction-row-menu-btn"
                                                              IconCssClass="icon more-icon medium-icon"
                                                              RenderStyle="ButtonRenderStyle.Link"
                                                              DropDownToggleVisible="false"
                                                              Enabled="@CanOperateOnCurrentDataset"
                                                              Tooltip="Tác vụ dòng khấu trừ khác">
                                                <Items>
                                                    <DxDropDownButtonItem Text="Điều chỉnh"
                                                                          IconUrl="@VntaDevExpressIcons.Edit"
                                                                          Click="@(() => OpenEditPopup(row))"
                                                                          Enabled="@CanEditRow(row)" />
                                                    <DxDropDownButtonItem Text="Làm mới"
                                                                          IconUrl="@VntaDevExpressIcons.Refresh"
                                                                          Click="@(() => RefreshRowAsync(row))"
                                                                          Enabled="@CanRefreshRow(row)" />
                                                    <DxDropDownButtonItem Text="@row.LockActionText"
                                                                          IconUrl="@(row.IsLocked ? VntaDevExpressIcons.Unlock : VntaDevExpressIcons.Lock)"
                                                                          Click="@(() => ToggleLockStateAsync(row))"
                                                                          Enabled="@CanToggleLock(row)"
                                                                          BeginGroup="true" />
                                                    <DxDropDownButtonItem Text="Bảng công tháng"
                                                                          IconUrl="@VntaDevExpressIcons.TaskList"
                                                                          Click="@(() => OpenMonthlyWorkPopupAsync(row))"
                                                                          Enabled="@CanViewMonthlyWork(row)" />
                                                </Items>
                                            </DxDropDownButton>
                                        </div>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="EmployeeDisplay" Caption="Nhân viên" MinWidth="220">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (KhauTruKhacRecord)context.DataItem;
                                        }
                                        @HighlightSearchText(row.EmployeeDisplay)
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="DepartmentDisplay" Caption="Bộ phận" MinWidth="160" Visible="false">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (KhauTruKhacRecord)context.DataItem;
                                        }
                                        @HighlightSearchText(row.DepartmentDisplay)
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="PositionDisplay" Caption="Chức vụ" MinWidth="160" Visible="false">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (KhauTruKhacRecord)context.DataItem;
                                        }
                                        @HighlightSearchText(row.PositionDisplay)
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="DescriptionDisplay" Caption="Mô tả" MinWidth="160">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (KhauTruKhacRecord)context.DataItem;
                                        }
                                        <span class="@GetRuleStatusCssClass(row.Description)">@row.DescriptionDisplay</span>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="DeductionAmount" Caption="Khấu trừ khác" MinWidth="150">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (KhauTruKhacRecord)context.DataItem;
                                        }
                                        <span class="hrm-grid-amount hrm-grid-amount--total">@FormatCurrency(row.DeductionAmount)</span>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="Note" Caption="Ghi chú" MinWidth="180">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (KhauTruKhacRecord)context.DataItem;
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.Note))
                                        {
                                            @HighlightSearchText(row.Note)
                                        }
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="IsLocked" Caption="Trạng thái khóa" MinWidth="120">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (KhauTruKhacRecord)context.DataItem;
                                        }
                                        <span class="@GetLockStatusCssClass(row.IsLocked)">@row.LockStatusText</span>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                            </Columns>

                            <TotalSummary>
                                <DxGridSummaryItem Name="DeductionAmountTotal"
                                                   FieldName="@nameof(KhauTruKhacRecord.DeductionAmount)"
                                                   SummaryType="GridSummaryItemType.Sum"
                                                   Visible="false" />
                            </TotalSummary>

                            <EmptyDataAreaTemplate>
                                <div class="empty-state">
                                    <div class="state-title">@EmptyStateTitle</div>
                                    <div class="state-message">@EmptyStateMessage</div>
                                    <DxButton Text="@EmptyStateActionText"
                                              Click="OnEmptyStateActionClick"
                                              RenderStyle="ButtonRenderStyle.Primary"
                                              RenderStyleMode="ButtonRenderStyleMode.Contained" />
                                </div>
                            </EmptyDataAreaTemplate>
                        </DxGrid>
                    </div>
                </HrmLoadingPanel>
            </div>
        }
    </div>

    <div class="other-deduction-export-source" aria-hidden="true">
        <DxGrid @ref="ExportGrid"
                Data="@ExportRecords"
                KeyFieldName="Id"
                ShowAllRows="true"
                PagerVisible="false"
                TextWrapEnabled="true">
            <Columns>
                <DxGridDataColumn FieldName="EmployeeDisplay" Caption="Nhân viên" />
                <DxGridDataColumn FieldName="DepartmentDisplay" Caption="Bộ phận" />
                <DxGridDataColumn FieldName="PositionDisplay" Caption="Chức vụ" />
                <DxGridDataColumn FieldName="DescriptionDisplay" Caption="Mô tả" />
                <DxGridDataColumn FieldName="DeductionAmount" Caption="Khấu trừ khác" DisplayFormat="#,##0 'đ';-#,##0 'đ';''" />
                <DxGridDataColumn FieldName="Note" Caption="Ghi chú">
                    <CellDisplayTemplate>
                        @{
                            var row = (KhauTruKhacRecord)context.DataItem;
                        }
                        @row.Note
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="LockStatusText" Caption="Trạng thái khóa" />
            </Columns>
        </DxGrid>
    </div>
</div>

<KhauTruKhacMonthlyWorkPopup Visible="@IsMonthlyWorkPopupVisible"
                                 VisibleChanged="@(_ => CloseMonthlyWorkPopup())"
                                 IsLoading="@IsMonthlyWorkPopupLoading"
                                 Title="@MonthlyWorkPopupTitle"
                                 Context="@MonthlyWorkPopupContext"
                                 ErrorMessage="@MonthlyWorkPopupErrorMessage"
                                 Rows="@MonthlyWorkRows"
                                 SalaryWorkDays="@MonthlyWorkPopupSalaryWorkDays"
                                 RefreshRequested="RefreshMonthlyWorkPopupAsync" />

<KhauTruKhacRulesPopup @bind-Visible="IsRulesPopupVisible" />

<KhauTruKhacLockActionPopup Visible="@IsLockActionPopupVisible"
                                VisibleChanged="@(_ => CloseLockActionPopup())"
                                IsRefreshing="@IsRefreshing"
                                Title="@LockActionPopupTitle"
                                PromptText="@LockActionPromptText"
                                ContextText="@LockActionScopeContextText"
                                SelectedScope="@SelectedLockActionScope"
                                SelectedRowsScope="@LockScopeSelectedRows"
                                WholePeriodScope="@LockScopeWholePeriod"
                                SelectedRowsDescription="@SelectedRowsScopeDescription"
                                WholePeriodDescription="@WholePeriodScopeDescription"
                                WholePeriodLabel="@AppliedPeriodLabel"
                                CanChooseSelectedRowsScope="@CanChooseSelectedRowsScope"
                                CanConfirm="@CanConfirmLockAction"
                                ShouldLock="@PendingLockActionState"
                                ScopeSelected="SelectLockActionScope"
                                ConfirmRequested="ConfirmLockActionAsync" />

<KhauTruKhacEditPopup Visible="@IsEditPopupVisible"
                           VisibleChanged="@(_ => CloseEditPopup())"
                           IsSaving="@IsSavingEdit"
                           Title="@EditPopupTitle"
                           Model="@EditModel"
                           CanEditFields="@(!IsSavingEdit && !EditModel.IsLocked && !HasPendingPeriodChange)"
                           CanSave="@CanSaveEdit"
                           SaveRequested="SaveEditAsync" />

<KhauTruKhacRecalculateConfirmPopup Visible="@IsRecalculateConfirmPopupVisible"
                                         VisibleChanged="@(_ => CloseRecalculateConfirmPopup())"
                                         IsRefreshing="@IsRefreshing"
                                         PeriodLabel="@AppliedPeriodLabel"
                                         ConfirmRequested="ConfirmRecalculateAsync" />
