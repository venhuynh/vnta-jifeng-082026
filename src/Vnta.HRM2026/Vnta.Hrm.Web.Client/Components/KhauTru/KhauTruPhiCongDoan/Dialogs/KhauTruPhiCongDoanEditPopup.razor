<DxPopup Visible="@Visible"
         VisibleChanged="OnVisibleChangedAsync"
         HeaderText="@Title"
         Width="min(34rem, calc(100vw - 2rem))"
         ShowCloseButton="@(!IsSaving)"
         ShowFooter="true"
         CloseOnEscape="@(!IsSaving)"
         CloseOnOutsideClick="false"
         FooterCssClass="union-fee-edit-popup-footer"
         CssClass="union-fee-edit-popup">
    <BodyContentTemplate Context="popupContext">
        <div class="union-fee-edit-form">
            <DxFormLayout CaptionPosition="@CaptionPosition.Vertical">
                <DxFormLayoutItem Caption="Nhân viên" ColSpanMd="12">
                    <DxTextBox Text="@Model.EmployeeDisplay" ReadOnly="true" ValidationEnabled="false" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Phòng ban" ColSpanMd="6">
                    <DxTextBox Text="@Model.DepartmentDisplay" ReadOnly="true" ValidationEnabled="false" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Chức vụ" ColSpanMd="6">
                    <DxTextBox Text="@Model.PositionDisplay" ReadOnly="true" ValidationEnabled="false" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Kỳ lương" ColSpanMd="6">
                    <DxTextBox Text="@Model.PayrollPeriodDisplay" ReadOnly="true" ValidationEnabled="false" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Trạng thái khóa" ColSpanMd="6">
                    <DxTextBox Text="@(Model.IsLocked ? "Đã khóa" : "Đang mở")" ReadOnly="true" ValidationEnabled="false" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Số tiền phí công đoàn" ColSpanMd="12">
                    <DxMaskedInput T="decimal"
                                   Value="@Model.DeductionAmount"
                                   ValueChanged="OnDeductionAmountChangedAsync"
                                   Mask="n2"
                                   MaskMode="MaskMode.Numeric"
                                   Enabled="@CanEditFields">
                        <DxNumericMaskProperties Culture="@DisplayCulture" />
                    </DxMaskedInput>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="union-fee-edit-actions">
            <DxButton Text="Hủy"
                      Click="CloseAsync"
                      IconUrl="@VntaDevExpressIcons.Cancel"
                      Enabled="@(!IsSaving)"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline" />
            <DxButton Text="Lưu"
                      Click="SaveAsync"
                      IconUrl="@VntaDevExpressIcons.Save"
                      Enabled="@CanSave"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained" />
        </div>
    </FooterContentTemplate>
</DxPopup>
@namespace Vnta.Hrm.Web.Client.Components.KhauTru.KhauTruPhiCongDoan
