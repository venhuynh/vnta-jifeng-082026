@page "/payroll/deduction-summary"

@using Microsoft.AspNetCore.Authorization
@using Vnta.Hrm.Web.Client.Components.KhauTru.KhauTruTongHop.Export
@using Vnta.Hrm.Web.Client.Components.KhauTru.KhauTruTongHop.Sections

@attribute [Authorize(Policy = InternalAccountPolicies.PayrollAdministration)]
@rendermode InteractiveServer

<PageTitle>VNTA - Tổng kết khấu trừ</PageTitle>

<div class="content-root">
    <KhauTruTongKetToolbar TMonthOption="MonthOption"
                           Month="@ToolbarMonth"
                           Year="@ToolbarYear"
                           MinimumYear="@MinimumSupportedYear"
                           MaximumYear="@MaximumSupportedYear"
                           AvailableMonths="@AvailableMonthOptions"
                           CanChangeFilters="@CanChangeFilters"
                           CanView="@CanView"
                           CanInteract="@CanInteract"
                           CanOperateOnCurrentDataset="@CanOperateOnCurrentDataset"
                           CanSyncFromPreviousMonth="@CanSyncFromPreviousMonth"
                           CanRecalculate="@CanRecalculate"
                           CanOpenLockAction="@CanOpenLockAction"
                           CanOpenUnlockAction="@CanOpenUnlockAction"
                           CanExport="@CanExport"
                           CanExportSelected="@CanExportSelected"
                           MonthChanged="OnToolbarMonthChangedAsync"
                           YearChanged="OnToolbarYearChangedAsync"
                           ViewRequested="OnViewRequestedAsync"
                           SyncFromPreviousMonthRequested="OnSyncFromPreviousMonthClick"
                           RecalculateRequested="OnRecalculateClickAsync"
                           LockRequested="OnLockSelectedAsync"
                           UnlockRequested="OnUnlockSelectedAsync"
                           RulesRequested="OpenRulesPopup"
                           ExportAllExcelRequested="ExportAllDataToExcelAsync"
                           ExportAllPdfRequested="ExportAllDataToPdfAsync"
                           ExportSelectedExcelRequested="ExportSelectedRowsToExcel"
                           ExportSelectedPdfRequested="ExportSelectedRowsToPdf"
                           ColumnChooserRequested="OnColumnChooserRequested" />

    @if(!string.IsNullOrWhiteSpace(DefaultPeriodWarningMessage))
    {
        <div class="card deduction-summary-period-warning" role="status">
            @DefaultPeriodWarningMessage
        </div>
    }

    <KhauTruTongKetGridSection @ref="GridSection"
                                State="@GridState"
                                HasLoadError="@HasLoadError"
                                LoadErrorMessage="@LoadErrorMessage"
                                ShowLoadingPanel="@ShowLoadingPanel"
                                LoadingText="@LoadingText"
                                HighlightSearchText="HighlightSearchText"
                                FormatMoney="FormatMoney"
                                RetryRequested="OnRetryAsync"
                                SearchTextChanged="OnSearchTextChanged"
                                LockStatusSelected="SelectLockStatusAsync"
                                SelectedDataItemsChanged="OnSelectedDataItemsChanged"
                                FilterCriteriaChanged="OnGridFilterCriteriaChangedAsync"
                                EditRequested="OpenEditPopup"
                                RefreshRequested="RefreshRowAsync"
                                ToggleLockRequested="ToggleLockStateAsync"
                                MonthlyWorkRequested="OpenMonthlyWorkPopupAsync"
                                EmptyStateActionRequested="OnEmptyStateActionClick"
                                ActivePageIndexChanged="OnActivePageIndexChangedAsync"
                                PageSizeChanged="OnPageSizeChanged" />

    <KhauTruTongKetExportGrid @ref="ExportSection" Records="@ExportRecords" />
</div>

<KhauTruTongKetSyncFromPreviousMonthPopup Visible="@IsSyncFromPreviousMonthPopupVisible"
                                           VisibleChanged="CloseSyncFromPreviousMonthPopup"
                                           IsSyncing="@IsSyncingPreviousMonth"
                                           SourcePeriodLabel="@PreviousMonthSyncSourcePeriodLabel"
                                           TargetPeriodLabel="@CurrentPayrollPeriodDisplay"
                                           ConfirmRequested="ConfirmSyncFromPreviousMonthAsync" />

<KhauTruTongKetMonthlyWorkPopup Visible="@IsMonthlyWorkPopupVisible"
                                 VisibleChanged="@(_ => CloseMonthlyWorkPopup())"
                                 IsLoading="@IsMonthlyWorkPopupLoading"
                                 Title="@MonthlyWorkPopupTitle"
                                 Context="@MonthlyWorkPopupContext"
                                 ErrorMessage="@MonthlyWorkPopupErrorMessage"
                                 Rows="@MonthlyWorkRows"
                                 RefreshRequested="RefreshMonthlyWorkPopupAsync" />

<KhauTruTongKetRulesPopup @bind-Visible="IsRulesPopupVisible"
                           PayrollPeriodDisplay="@RulesPopupPeriodDisplay" />

<KhauTruTongKetRecalculateConfirmPopup Visible="@IsRecalculateConfirmPopupVisible"
                                        VisibleChanged="@(_ => CloseRecalculateConfirmPopup())"
                                        IsRefreshing="@IsRefreshing"
                                        PeriodLabel="@CurrentPayrollPeriodDisplay"
                                        ConfirmRequested="ConfirmRecalculateAsync" />

<KhauTruTongKetEditPopup Visible="@IsEditPopupVisible"
                           VisibleChanged="@(_ => CloseEditPopup())"
                           IsSaving="@IsSavingEdit"
                           Title="@EditPopupTitle"
                           Model="@EditModel"
                           CanEditFields="@CanEditFields"
                           CanSave="@CanSaveEdit"
                           SaveRequested="SaveEditAsync" />

<KhauTruTongKetLockActionPopup Visible="@IsLockActionPopupVisible"
                                 VisibleChanged="@(_ => CloseLockActionPopup())"
                                 IsRefreshing="@IsRefreshing"
                                 Title="@LockActionPopupTitle"
                                 PromptText="@LockActionPromptText"
                                 ContextText="@LockActionScopeContextText"
                                 SelectedScope="@SelectedLockActionScope"
                                 SelectedRowsScope="@LockScopeSelectedRows"
                                 WholePeriodScope="@LockScopeWholePeriod"
                                 SelectedRowsDescription="@SelectedRowsScopeDescription"
                                 WholePeriodDescription="@WholePeriodScopeDescription"
                                 WholePeriodLabel="@CurrentPayrollPeriodDisplay"
                                 CanChooseSelectedRowsScope="@CanChooseSelectedRowsScope"
                                 CanConfirm="@CanConfirmLockAction"
                                 ShouldLock="@PendingLockActionState"
                                 ScopeSelected="SelectLockActionScope"
                                 ConfirmRequested="ConfirmLockActionAsync" />
