@namespace Vnta.Hrm.Web.Client.Components.KhauTru.KhauTruTongHop.Sections
@using DevExpress.Blazor
@typeparam TMonthOption

<div class="card toolbar">
    <DxToolbar Title="Tổng kết khấu trừ"
               CssClass="toolbar"
               ItemRenderStyleMode="ToolbarRenderStyleMode.Plain">
        <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                       CssClass="toolbar-filter-item"
                       Tooltip="Chọn năm kỳ lương">
            <Template>
                <div class="custom-item toolbar-filter-editor">
                    <span class="toolbar-filter-label">Năm</span>
                    <DxSpinEdit T="int"
                                Value="@Year"
                                ValueChanged="YearChanged"
                                MinValue="@MinimumYear"
                                MaxValue="@MaximumYear"
                                Increment="1"
                                ShowSpinButtons="true"
                                Enabled="@CanChangeFilters"
                                CssClass="toolbar-filter-year" />
                </div>
            </Template>
        </DxToolbarItem>
        <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                       CssClass="toolbar-filter-item"
                       Tooltip="Chọn tháng kỳ lương">
            <Template>
                <div class="custom-item toolbar-filter-editor">
                    <span class="toolbar-filter-label">Tháng</span>
                    <DxComboBox TData="TMonthOption"
                                TValue="int"
                                @key="Year"
                                Data="@AvailableMonths"
                                Value="@Month"
                                ValueChanged="MonthChanged"
                                ValueFieldName="@ValueFieldName"
                                TextFieldName="@TextFieldName"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                Enabled="@CanChangeFilters"
                                CssClass="toolbar-filter-month" />
                </div>
            </Template>
        </DxToolbarItem>
        <DxToolbarItem Text="Xem"
                       Click="ViewRequested"
                       Enabled="@CanView"
                       Alignment="ToolbarItemAlignment.Right"
                       Tooltip="Tải dữ liệu tổng kết khấu trừ theo kỳ lương đã chọn"
                       IconUrl="@VntaDevExpressIcons.FolderOpenArrowImport" />
        <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                       Tooltip="Nhóm thao tác trên dữ liệu tổng kết khấu trừ">
            <Template>
                <div class="custom-item">
                    <DxDropDownButton Text="Hành động"
                                      IconUrl="@VntaDevExpressIcons.TaskList"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                                      Enabled="@CanOperateOnCurrentDataset"
                                      CssClass="toolbar-action-dropdown">
                        <Items>
                            <DxDropDownButtonItem Text="Lấy từ tháng trước"
                                                  IconUrl="@VntaDevExpressIcons.Refresh"
                                                  Click="SyncFromPreviousMonthRequested"
                                                  Enabled="@CanSyncFromPreviousMonth" />
                            <DxDropDownButtonItem Text="Làm mới khấu trừ"
                                                  IconUrl="@VntaDevExpressIcons.CalculatorCoins"
                                                  Click="RecalculateRequested"
                                                  Enabled="@CanRecalculate" />
                            <DxDropDownButtonItem Text="Khóa"
                                                  IconUrl="@VntaDevExpressIcons.Lock"
                                                  Click="LockRequested"
                                                  Enabled="@CanOpenLockAction"
                                                  BeginGroup="true" />
                            <DxDropDownButtonItem Text="Mở khóa"
                                                  IconUrl="@VntaDevExpressIcons.Unlock"
                                                  Click="UnlockRequested"
                                                  Enabled="@CanOpenUnlockAction" />
                        </Items>
                    </DxDropDownButton>
                </div>
            </Template>
        </DxToolbarItem>
        <DxToolbarItem Text="Quy tắc"
                       Click="RulesRequested"
                       Enabled="@CanInteract"
                       Alignment="ToolbarItemAlignment.Right"
                       Tooltip="Xem nguồn dữ liệu và quy tắc tổng kết khấu trừ"
                       IconUrl="@VntaDevExpressIcons.TextBoxDescription" />
        <DxToolbarItem Text="Xuất dữ liệu"
                       Enabled="@CanExport"
                       Alignment="ToolbarItemAlignment.Right"
                       Tooltip="Xuất dữ liệu tổng kết khấu trừ của kỳ đang áp dụng"
                       IconUrl="@VntaDevExpressIcons.Export">
            <Items>
                <DxToolbarItem Text="Xuất toàn bộ kỳ ra Excel"
                               Click="ExportAllExcelRequested"
                               Enabled="@CanExport"
                               IconUrl="@VntaDevExpressIcons.Excel" />
                <DxToolbarItem Text="Xuất toàn bộ kỳ ra PDF"
                               Click="ExportAllPdfRequested"
                               Enabled="@CanExport"
                               IconUrl="@VntaDevExpressIcons.Pdf" />
                <DxToolbarItem Text="Xuất dòng đã chọn ra Excel"
                               Click="ExportSelectedExcelRequested"
                               Enabled="@CanExportSelected"
                               IconUrl="@VntaDevExpressIcons.Excel" />
                <DxToolbarItem Text="Xuất dòng đã chọn ra PDF"
                               Click="ExportSelectedPdfRequested"
                               Enabled="@CanExportSelected"
                               IconUrl="@VntaDevExpressIcons.Pdf" />
            </Items>
        </DxToolbarItem>
        <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                       Tooltip="Chọn cột hiển thị trong lưới tổng kết khấu trừ"
                       Enabled="@CanOperateOnCurrentDataset"
                       Click="ColumnChooserRequested"
                       IconUrl="@VntaDevExpressIcons.ColumnChooser" />
    </DxToolbar>
</div>
