@using Microsoft.AspNetCore.Components.Forms

<DxPopup Visible="@Visible"
         VisibleChanged="OnVisibleChangedAsync"
         HeaderText="Điều chỉnh số ngày công thực tế"
         Width="min(34rem, calc(100vw - 2rem))"
         ShowCloseButton="@(!IsSaving)"
         ShowFooter="true"
         CloseOnEscape="@(!IsSaving)"
         CloseOnOutsideClick="false"
         CssClass="attendance-allowance-edit-popup">
    <BodyContentTemplate Context="editPopupBody">
        <div class="attendance-allowance-edit-content">
            <EditForm EditContext="@EditContext" Context="editFormContext">
                <DataAnnotationsValidator />
                <DxFormLayout CaptionPosition="@CaptionPosition.Vertical">
                    <DxFormLayoutItem Caption="Nhân viên" ColSpanMd="12">
                        <DxTextBox Text="@Model.EmployeeDisplay"
                                   ReadOnly="true"
                                   ValidationEnabled="false"
                                   CssClass="attendance-allowance-edit-readonly" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Kỳ lương" ColSpanMd="6">
                        <DxTextBox Text="@Model.PayrollPeriodDisplay"
                                   ReadOnly="true"
                                   ValidationEnabled="false"
                                   CssClass="attendance-allowance-edit-readonly" />
                    </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Số ngày công chuẩn" ColSpanMd="6">
                        <DxSpinEdit T="decimal"
                                    @bind-Value="Model.StandardWorkdayCount"
                                    ValidationEnabled="true"
                                    MinValue="0.01m"
                                    DisplayFormat="0.0"
                                    ShowSpinButtons="true"
                                    ShowValidationIcon="true"
                                    Enabled="@CanEditFields" />
                        <ValidationMessage For="@(() => Model.StandardWorkdayCount)" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Số ngày công thực tế" ColSpanMd="6">
                        <DxSpinEdit T="decimal"
                                    @bind-Value="Model.ActualWorkdayCount"
                                    MinValue="0m"
                                    MaxValue="@Model.StandardWorkdayCount"
                                    Increment="0.5m"
                                    DisplayFormat="0.0"
                                    ShowSpinButtons="true"
                                    ShowValidationIcon="true"
                                    Enabled="@CanEditFields" />
                        <ValidationMessage For="@(() => Model.ActualWorkdayCount)" />
                    </DxFormLayoutItem>
                </DxFormLayout>

            </EditForm>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="attendance-allowance-edit-actions">
            <DxButton Text="Hủy"
                      Click="CloseAsync"
                      IconUrl="@VntaDevExpressIcons.Cancel"
                      Enabled="@(!IsSaving)"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline" />
            <DxButton Text="Lưu"
                      Click="SaveAsync"
                      IconUrl="@VntaDevExpressIcons.Save"
                      Enabled="@CanSave"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained" />
        </div>
    </FooterContentTemplate>
</DxPopup>
