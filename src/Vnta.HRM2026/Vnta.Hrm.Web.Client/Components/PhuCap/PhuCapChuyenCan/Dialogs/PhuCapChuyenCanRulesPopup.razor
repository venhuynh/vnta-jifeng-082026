@using DevExpress.Blazor
@using Vnta.Hrm.Web.Client.Services.Ui

<DxPopup Visible="@Visible"
         VisibleChanged="@OnVisibleChangedAsync"
         HeaderText="Quy tắc phụ cấp chuyên cần"
         Width="min(58rem, calc(100vw - 2rem))"
         ShowCloseButton="true"
         ShowFooter="true"
         CloseOnEscape="true"
         CloseOnOutsideClick="false"
         CssClass="attendance-rules-popup">
    <BodyContentTemplate Context="popupBody">
        <div class="attendance-rules-content">
            <div class="attendance-rules-section">
                <div class="attendance-rules-title">Yêu cầu dữ liệu</div>
                <ul class="attendance-rules-list">
                    <li>Đảm bảo dữ liệu phải đồng bộ 1-1 với bảng <strong>Tổng hợp phụ cấp</strong>.</li>
                    <li>Bỏ qua các dòng đã khóa.</li>
                </ul>
            </div>

            <div class="attendance-rules-section">
                <div class="attendance-rules-title">Quy tắc tính công</div>
                @if(IsRuleLoading)
                {
                    <div>Đang tải cấu hình mã chuyên cần...</div>
                }
                else if(Rule is { EligibleStatusCodes.Count: > 0 } rule)
                {
                    <div>Các mã đang được cấu hình cho phụ cấp chuyên cần: <strong>@string.Join(", ", rule.EligibleStatusCodes)</strong>.</div>
                }
                else
                {
                    <div>Chưa có mã nào được cấu hình cho phụ cấp chuyên cần.</div>
                }
                <ol class="attendance-rules-list">
                    <li>Các code áp dụng để tính 1 công HC là bảng <strong>Code kết quả tính công</strong> - cột <strong>Chuyên cần</strong>. Mỗi record có nằm trong các code này thì tính là 1 ngày công HC. Kết quả là ngày công HC (viết tắt <strong>Công HC</strong>).</li>
                    <li>Tìm trong bảng công tháng tổng số phút đi trễ, về sớm và chia cho <strong>480</strong>. Kết quả là <strong>Số ngày ĐTVS</strong>, số thập phân lấy 4 chữ số.</li>
                    <li>Tìm công tính lương (<strong>CTL</strong>) = <strong>Công HC − Tổng đi trễ về sớm</strong>. Kết quả lấy 4 chữ số thập phân.</li>
                </ol>
            </div>

            <div class="attendance-rules-section">
                <div class="attendance-rules-title">Xếp mức chuyên cần</div>
                <ol class="attendance-rules-list" start="4">
                    <li>
                        <strong>Ưu tiên 1 (cao nhất):</strong> nếu trong bảng công tháng có <strong>CODE = KP</strong> (nghỉ không phép), số tiền chuyên cần <strong>C = 0 đồng</strong>.
                    </li>
                    <li>Tìm <strong>Số ngày thiếu công (Thiếu công)</strong> = <strong>Công chuẩn − CTL</strong> (giống quy tắc của Trách nhiệm).</li>
                    <li>Nếu <strong>Thiếu công ≤ 1.0625</strong> thì Chuyên cần <strong>A = 600.000 đồng</strong>.</li>
                    <li>Nếu <strong>Thiếu công &gt; 1.0625</strong> và <strong>≤ 3.0625</strong> thì Chuyên cần <strong>B = 300.000 đồng</strong>.</li>
                    <li>Còn lại, Chuyên cần <strong>C = 0 đồng</strong>.</li>
                </ol>
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate Context="popupFooter">
        <DxButton Text="Đóng"
                  Click="@CloseAsync"
                  IconUrl="@VntaDevExpressIcons.Cancel"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  RenderStyleMode="ButtonRenderStyleMode.Contained" />
    </FooterContentTemplate>
</DxPopup>
