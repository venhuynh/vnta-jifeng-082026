@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components
@using Vnta.Hrm.Web.Client.Components.PhuCap.PhuCapChuyenCan.Models

<div class="attendance-allowance-grid-header">
    <div class="attendance-allowance-summary-strip">
        <DxButtonGroup CssClass="attendance-allowance-summary-button-group" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline" SelectionMode="ButtonGroupSelectionMode.Single" Enabled="@CanInteract">
            <Items>
                @foreach(var badge in SummaryBadges)
                {
                    <DxButtonGroupItem Text="@($"{badge.ShortLabel} {badge.Count:N0}")" Tooltip="@badge.Label" CssClass="@($"attendance-allowance-summary-button attendance-allowance-summary-button-{badge.Key}")" Selected="@(badge.Key == ActiveSummaryBadgeKey)" Click="@(() => SummaryBadgeSelected.InvokeAsync(badge.Key))" />
                }
            </Items>
        </DxButtonGroup>
        <DxButtonGroup CssClass="attendance-allowance-total-amount-button-group" RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ButtonRenderStyleMode.Outline">
            <Items>
                <DxButtonGroupItem Text="@($"Tổng PC: {FormatMoney(VisibleActualAllowanceTotal)}")" Tooltip="Tổng phụ cấp thực tế của các dòng đang hiển thị trên trang" CssClass="attendance-allowance-total-amount-button" />
            </Items>
        </DxButtonGroup>
    </div>
    <div class="attendance-allowance-grid-search">
        <DxSearchBox CssClass="attendance-allowance-grid-searchbox" NullText="Tìm kiếm nhân viên, phòng ban, chức vụ" BindValueMode="BindValueMode.OnDelayedInput" InputDelay="500" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" Text="@SearchText" TextChanged="SearchTextChanged" Enabled="@CanInteract" />
    </div>
</div>
