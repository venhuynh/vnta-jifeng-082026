@namespace Vnta.Hrm.Web.Client.Components.PhuCap.PhuCapCom

<DxPopup Visible="@Visible"
         VisibleChanged="OnVisibleChangedAsync"
         HeaderText="@Title"
         Width="560px"
         ShowCloseButton="@(!IsSaving)"
         ShowFooter="true"
         CloseOnEscape="true"
         CloseOnOutsideClick="false"
         FooterCssClass="meal-allowance-popup-footer"
         CssClass="meal-allowance-edit-popup">
    <BodyContentTemplate Context="editPopupBody">
        <div class="meal-allowance-edit-form">
            @if(!string.IsNullOrWhiteSpace(ValidationMessage))
            {
                <div class="form-error-message" role="alert">@ValidationMessage</div>
            }
            <DxFormLayout CaptionPosition="@CaptionPosition.Vertical">
                <DxFormLayoutItem Caption="Nhân viên" ColSpanMd="12">
                    <DxTextBox Text="@Model.EmployeeDisplay"
                               ReadOnly="true"
                               CssClass="meal-allowance-edit-readonly" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Số ngày đủ điều kiện" ColSpanMd="6">
                    <DxMaskedInput T="int"
                                Value="@Model.QualifiedMealDays"
                                ValueChanged="OnQualifiedMealDaysChangedAsync"
                                Mask="n0"
                                MaskMode="MaskMode.Numeric"
                                Enabled="@CanEditFields">
                        <DxNumericMaskProperties Culture="@DisplayCulture" />
                    </DxMaskedInput>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Ngày PC Cơm" ColSpanMd="6">
                    <DxTextBox Text="@FormatNumber(Model.Overtime1900Days)"
                               ReadOnly="true"
                               CssClass="meal-allowance-edit-readonly" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Đơn giá phụ cấp cơm/ngày" ColSpanMd="6">
                    <DxTextBox Text="@FormatMoney(Model.MealAllowancePerQualifiedDay)"
                               ReadOnly="true"
                               CssClass="meal-allowance-edit-readonly" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Phụ cấp cơm" ColSpanMd="6">
                    <DxTextBox Text="@FormatMoney(Model.MealAllowanceAmount)"
                               ReadOnly="true"
                               CssClass="meal-allowance-edit-readonly" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Ghi chú" ColSpanMd="12">
                    <DxMemo @bind-Text="Model.Note"
                            NullText="Nhập ghi chú điều chỉnh"
                            Rows="4"
                            Enabled="@CanEditFields" />
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="meal-allowance-edit-actions">
            <DxButton Text="Hủy"
                      Click="CloseAsync"
                      IconUrl="@VntaDevExpressIcons.Cancel"
                      CssClass="meal-allowance-popup-action"
                      Enabled="@(!IsSaving)"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline" />
            <DxButton Text="Lưu"
                      Click="SaveAsync"
                      IconUrl="@VntaDevExpressIcons.Save"
                      CssClass="meal-allowance-popup-action"
                      Enabled="@CanSave"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained" />
        </div>
    </FooterContentTemplate>
</DxPopup>
