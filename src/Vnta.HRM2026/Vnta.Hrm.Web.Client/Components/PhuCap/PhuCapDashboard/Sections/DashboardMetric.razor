<div class="dashboard-metric">
    <div class="dashboard-metric-title">@Title</div>
    <div class="dashboard-metric-value">@Value</div>
    <div class="dashboard-metric-detail @TrendCssClass">@Detail</div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string Detail { get; set; } = string.Empty;
    [Parameter] public double Trend { get; set; }

    private string TrendCssClass => Trend switch
    {
        > 0d => "positive",
        < 0d => "negative",
        _ => string.Empty
    };
}
