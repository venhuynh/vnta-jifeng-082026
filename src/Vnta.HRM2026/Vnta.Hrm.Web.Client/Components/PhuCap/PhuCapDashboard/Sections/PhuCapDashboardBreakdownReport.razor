@using DevExpress.Blazor
@using Vnta.Hrm.Application.PhuCap.PhuCapTongHop

<div class="dashboard-report">
    <div class="dashboard-section-header">
        <div class="dashboard-section-title">Cơ cấu phụ cấp</div>
        <DxButton IconUrl="@VntaDevExpressIcons.Refresh" Click="RefreshRequested" Enabled="@(!IsRefreshing)" Tooltip="Tải lại dashboard phụ cấp" CssClass="dashboard-report-refresh" />
    </div>
    @if(NonZeroBreakdown.Count == 0)
    {
        <div class="dashboard-report-message">Chưa có dữ liệu cơ cấu phụ cấp cho kỳ đã chọn.</div>
    }
    else
    {
        <DxPieChart Data="@ChartPoints" InnerDiameter="0.55" T="BreakdownChartPoint" CssClass="allowance-pie-chart" CustomizeSeriesPoint="CustomizeBreakdownPoint">
            <DxPieChartSeries T="BreakdownChartPoint" TArgument="string" TValue="double" ArgumentField="item => item.AllowanceType" ValueField="item => item.Amount">
                <DxChartSeriesLabel Visible="true"
                                    Position="RelativePosition.Outside"
                                    TextOverflow="ChartTextOverflow.None"
                                    WordWrap="ChartWordWrap.None">
                    <DxChartSeriesLabelConnector Visible="true" />
                </DxChartSeriesLabel>
            </DxPieChartSeries>
            <DxChartLegend HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalEdge.Bottom" Position="RelativePosition.Outside" />
        </DxPieChart>
    }
</div>
