@page "/payroll/seniority-allowance"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Policy = InternalAccountPolicies.PayrollAdministration)]
@rendermode InteractiveServer

<PageTitle>VNTA - Phụ cấp thâm niên</PageTitle>

<div class="content-root">
    <div class="card toolbar">
        <PhuCapThamNienToolbar Month="@ToolbarMonth"
                              Year="@ToolbarYear"
                              AvailableMonths="@AvailableMonthOptions"
                              MinimumYear="@MinimumSupportedYear"
                              MaximumYear="@MaximumSupportedYear"
                              CanChangeFilters="@CanChangeFilters"
                              CanView="@CanView"
                              CanOperate="@CanOperateOnCurrentDataset"
                              CanRecalculate="@CanRecalculate"
                              CanLock="@CanOpenLockAction"
                              CanUnlock="@CanOpenUnlockAction"
                              CanInteract="@CanInteract"
                              CanExport="@CanExport"
                              MonthChanged="@OnSelectedMonthChangedAsync"
                              YearChanged="@OnSelectedYearChangedAsync"
                              ViewRequested="@OnViewRequestedAsync"
                              RecalculateRequested="@OnRecalculateClickAsync"
                              LockRequested="@OnLockSelectedAsync"
                              UnlockRequested="@OnUnlockSelectedAsync"
                              RulesRequested="@OpenRulesPopup"
                              ExportExcelRequested="@ExportAllDataToExcelAsync"
                              ExportPdfRequested="@ExportAllDataToPdfAsync"
                              ColumnChooserRequested="@OnColumnChooserRequested" />
    </div>
    <div class="seniority-allowance-root">
        @if (HasLoadError)
        {
            <PhuCapThamNienLoadError Message="@LoadErrorMessage" RetryRequested="@OnRetryAsync" />
        }
        else
        {
            <div class="card seniority-allowance-grid-card">
                <HrmLoadingPanel Visible="@ShowLoadingPanel"
                                 IsContentBlocked="true"
                                 IsContentVisible="true"
                                 IndicatorVisible="true"
                                 IndicatorAreaVisible="true"
                                 Text="@LoadingText"
                                 CssClass="seniority-allowance-loading-panel">
                    <div class="seniority-allowance-grid-content">
                        <PhuCapThamNienSummary RangeBadges="@SeniorityRangeBadges"
                                                SelectedKey="@SelectedRangeKey"
                                                TotalAllowanceAmount="@ServerTotalAllowanceAmount"
                                                SearchText="@SearchText"
                                                CanInteract="@CanInteract"
                                                GetRangeBadgeCssClass="@GetRangeBadgeCssClass"
                                                FormatCurrency="@FormatCurrency"
                                                RangeSelected="@SelectRangeAsync"
                                                SearchTextChanged="@OnSearchTextChanged" />
                        <PhuCapThamNienGrid @ref="GridSection"
                                            Records="@AllRecords"
                                            SelectedDataItems="@SelectedDataItems"
                                            CurrentPageIndex="@CurrentPageIndex"
                                            PageSize="@PageSize"
                                            EmptyStateTitle="@EmptyStateTitle"
                                            EmptyStateMessage="@EmptyStateMessage"
                                            EmptyStateActionText="@EmptyStateActionText"
                                            CanOperate="@CanOperateOnCurrentDataset"
                                            CanEdit="@CanEditRow"
                                            CanRefresh="@CanRefreshRow"
                                            CanToggleLock="@CanToggleLock"
                                            CanViewMonthlyWork="@CanViewMonthlyWork"
                                            GetRuleStatusCssClass="@GetRuleStatusCssClass"
                                            GetLockStatusCssClass="@GetLockStatusCssClass"
                                            FormatCurrency="@FormatCurrency"
                                            FormatAdministrativeWorkDays="@FormatAdministrativeWorkDays"
                                            FormatWorkDays="@FormatWorkDays"
                                            HighlightSearchText="@HighlightSearchText"
                                            SelectedDataItemsChanged="@OnSelectedDataItemsChanged"
                                            EmptyStateActionRequested="@OnEmptyStateActionClick"
                                            EditRequested="@OpenEditPopup"
                                            RefreshRequested="@RefreshRowAsync"
                                            LockToggleRequested="@ToggleLockStateAsync"
                                            MonthlyWorkRequested="@OpenMonthlyWorkPopupAsync" />
                        <PhuCapThamNienPager SummaryText="@PagerSummaryText"
                                                TotalPageCount="@TotalPageCount"
                                                CurrentPageIndex="@CurrentPageIndex"
                                                PageSizeOptions="@AvailablePageSizeOptions"
                                                PageSize="@PageSize"
                                                CanBrowsePages="@CanBrowsePages"
                                                CanChangeFilters="@CanChangeFilters"
                                                PageChanged="OnActivePageIndexChangedAsync"
                                                PageSizeChanged="@OnPageSizeChanged"
                                                PageSizeDescription="@PageSizeDescription" />
                    </div>
                </HrmLoadingPanel>
            </div>
        }
    </div>

    <PhuCapThamNienExportGrid @ref="ExportSource"
                               Records="@ExportRecords"
                               FormatAdministrativeWorkDays="@FormatAdministrativeWorkDays"
                               FormatWorkDays="@FormatWorkDays"
                               Rendered="@OnExportGridRendered" />
</div>

@using Vnta.Hrm.Web.Client.Components.ChamCong.MonthlyWork

<ChamCongMonthlyWorkPopup Visible="@IsMonthlyWorkPopupVisible"
                                 VisibleChanged="@(_ => CloseMonthlyWorkPopup())"
                                 IsLoading="@IsMonthlyWorkPopupLoading"
                                 Title="@MonthlyWorkPopupTitle"
                                 Context="@MonthlyWorkPopupContext"
                                 ErrorMessage="@MonthlyWorkPopupErrorMessage"
                                 Rows="@MonthlyWorkRows"
                                 SalaryWorkDays="@MonthlyWorkPopupSalaryWorkDays"
                                 RefreshRequested="RefreshMonthlyWorkPopupAsync" />

<PhuCapThamNienRulesPopup @bind-Visible="IsRulesPopupVisible" />

<PhuCapThamNienLockActionPopup Visible="@IsLockActionPopupVisible"
                                VisibleChanged="@(_ => CloseLockActionPopup())"
                                IsRefreshing="@IsRefreshing"
                                Title="@LockActionPopupTitle"
                                PromptText="@LockActionPromptText"
                                ContextText="@LockActionScopeContextText"
                                SelectedScope="@SelectedLockActionScope"
                                SelectedRowsScope="@LockScopeSelectedRows"
                                WholePeriodScope="@LockScopeWholePeriod"
                                SelectedRowsDescription="@SelectedRowsScopeDescription"
                                WholePeriodDescription="@WholePeriodScopeDescription"
                                WholePeriodLabel="@AppliedPeriodLabel"
                                CanChooseSelectedRowsScope="@CanChooseSelectedRowsScope"
                                CanConfirm="@CanConfirmLockAction"
                                ShouldLock="@PendingLockActionState"
                                ScopeSelected="SelectLockActionScope"
                                ConfirmRequested="ConfirmLockActionAsync" />

<PhuCapThamNienEditPopup Visible="@IsEditPopupVisible"
                           VisibleChanged="@(_ => CloseEditPopup())"
                           IsSaving="@IsSavingEdit"
                           Title="@EditPopupTitle"
                           Model="@EditModel"
                           ErrorMessage="@EditErrorMessage"
                           CanEditFields="@(!IsSavingEdit && !EditModel.IsLocked && !HasPendingPeriodChange)"
                           CanSave="@CanSaveEdit"
                           SaveRequested="SaveEditAsync" />

<PhuCapThamNienRecalculateConfirmPopup Visible="@IsRecalculateConfirmPopupVisible"
                                         VisibleChanged="@(_ => CloseRecalculateConfirmPopup())"
                                         IsRefreshing="@IsRefreshing"
                                         PeriodLabel="@AppliedPeriodLabel"
                                         ConfirmRequested="ConfirmRecalculateAsync" />
