@namespace Vnta.Hrm.Web.Client.Components.PhuCap.PhuCapThamNien
@using Microsoft.AspNetCore.Components

<DxGrid @ref="Grid" Data="@Records" KeyFieldName="Id" CssClass="seniority-allowance-grid" ShowSearchBox="false" PagerVisible="false" PageSize="@PageSize" SkeletonRowsEnabled="true" ColumnResizeMode="GridColumnResizeMode.NextColumn" FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Never" TextWrapEnabled="false" FocusedRowEnabled="true" HighlightRowOnHover="true" AllowSelectRowByClick="true" SelectionMode="GridSelectionMode.Multiple" SelectedDataItems="@SelectedDataItems" SelectedDataItemsChanged="@SelectedDataItemsChanged">
        <Columns>
            <DxGridSelectionColumn Width="3rem" />
            <DxGridDataColumn Caption="STT" Width="4.5rem" MinWidth="72" AllowSort="false"><CellDisplayTemplate>@(CurrentPageIndex * PageSize + context.VisibleIndex + 1)</CellDisplayTemplate></DxGridDataColumn>
            <DxGridDataColumn Caption="Tác vụ" MinWidth="96" Width="6rem" AllowSort="false" TextAlignment="GridTextAlignment.Center" ShowInColumnChooser="false">
                <CellDisplayTemplate>
                    @{ var row = (PhuCapThamNienRecord)context.DataItem; }
                    <div class="seniority-allowance-row-menu-host" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                        <DxDropDownButton CssClass="seniority-allowance-row-menu-btn" IconCssClass="icon more-icon medium-icon" RenderStyle="ButtonRenderStyle.Link" DropDownToggleVisible="false" Enabled="@CanOperate">
                            <Items>
                                <DxDropDownButtonItem Text="Điều chỉnh" IconUrl="@VntaDevExpressIcons.Edit" Click="@(() => EditRequested.InvokeAsync(row))" Enabled="@CanEdit(row)" />
                                <DxDropDownButtonItem Text="Làm mới" IconUrl="@VntaDevExpressIcons.Refresh" Click="@(() => RefreshRequested.InvokeAsync(row))" Enabled="@CanRefresh(row)" />
                                <DxDropDownButtonItem Text="@row.LockActionText" IconUrl="@(row.IsLocked ? VntaDevExpressIcons.Unlock : VntaDevExpressIcons.Lock)" Click="@(() => LockToggleRequested.InvokeAsync(row))" Enabled="@CanToggleLock(row)" BeginGroup="true" />
                                <DxDropDownButtonItem Text="Bảng công tháng" IconUrl="@VntaDevExpressIcons.TaskList" Click="@(() => MonthlyWorkRequested.InvokeAsync(row))" Enabled="@CanViewMonthlyWork(row)" />
                            </Items>
                        </DxDropDownButton>
                    </div>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="EmployeeDisplay" Caption="Nhân viên" MinWidth="220"><CellDisplayTemplate><span class="seniority-allowance-employee-text hrm-grid-emphasis">@HighlightSearchText(((PhuCapThamNienRecord)context.DataItem).EmployeeDisplay)</span></CellDisplayTemplate></DxGridDataColumn>
            <DxGridDataColumn FieldName="EmploymentStartDate" Caption="Ngày vào làm" MinWidth="120"><CellDisplayTemplate>@(((PhuCapThamNienRecord)context.DataItem).EmploymentStartDate?.ToString("dd/MM/yyyy") ?? "--")</CellDisplayTemplate></DxGridDataColumn>
            <DxGridDataColumn FieldName="DepartmentDisplay" Caption="Bộ phận" MinWidth="160" Visible="false"><CellDisplayTemplate>@HighlightSearchText(((PhuCapThamNienRecord)context.DataItem).DepartmentDisplay)</CellDisplayTemplate></DxGridDataColumn>
            <DxGridDataColumn FieldName="PositionDisplay" Caption="Chức vụ" MinWidth="160" Visible="false"><CellDisplayTemplate>@HighlightSearchText(((PhuCapThamNienRecord)context.DataItem).PositionDisplay)</CellDisplayTemplate></DxGridDataColumn>
            <DxGridDataColumn FieldName="SeniorityDisplay" Caption="Thâm niên" MinWidth="140" />
            <DxGridDataColumn FieldName="AdministrativeWorkDays" Caption="Công HC" MinWidth="110"><CellDisplayTemplate>@FormatAdministrativeWorkDays(((PhuCapThamNienRecord)context.DataItem).AdministrativeWorkDays)</CellDisplayTemplate></DxGridDataColumn>
            <DxGridDataColumn FieldName="LateEarlyLeaveWorkDays" Caption="ĐTVS" MinWidth="110"><CellDisplayTemplate>@FormatWorkDays(((PhuCapThamNienRecord)context.DataItem).LateEarlyLeaveWorkDays)</CellDisplayTemplate></DxGridDataColumn>
            <DxGridDataColumn FieldName="AppliedRuleDisplay" Caption="Quy tắc" MinWidth="160"><CellDisplayTemplate>@{ var row = (PhuCapThamNienRecord)context.DataItem; }<span class="@($"{GetRuleStatusCssClass(row.AppliedRuleKey)} hrm-grid-status")">@row.AppliedRuleDisplay</span></CellDisplayTemplate></DxGridDataColumn>
            <DxGridDataColumn FieldName="AllowanceAmount" Caption="Tiền phụ cấp" MinWidth="150" TextAlignment="GridTextAlignment.Right"><CellDisplayTemplate>@{ var row = (PhuCapThamNienRecord)context.DataItem; }<span class="hrm-grid-amount hrm-grid-amount--total">@FormatCurrency(row.AllowanceAmount)</span></CellDisplayTemplate></DxGridDataColumn>
            <DxGridDataColumn FieldName="Note" Caption="Ghi chú" MinWidth="180"><CellDisplayTemplate>@{ var note = ((PhuCapThamNienRecord)context.DataItem).Note; }@if (!string.IsNullOrWhiteSpace(note)) { @HighlightSearchText(note) }</CellDisplayTemplate></DxGridDataColumn>
            <DxGridDataColumn FieldName="IsLocked" Caption="Trạng thái khóa" MinWidth="120"><CellDisplayTemplate>@{ var row = (PhuCapThamNienRecord)context.DataItem; }<span class="@($"{GetLockStatusCssClass(row.IsLocked)} hrm-grid-status")">@row.LockStatusText</span></CellDisplayTemplate></DxGridDataColumn>
        </Columns>
        <EmptyDataAreaTemplate>
            <div class="empty-state"><div class="state-title">@EmptyStateTitle</div><div class="state-message">@EmptyStateMessage</div><DxButton Text="@EmptyStateActionText" Click="@EmptyStateActionRequested" RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ButtonRenderStyleMode.Contained" /></div>
        </EmptyDataAreaTemplate>
</DxGrid>
