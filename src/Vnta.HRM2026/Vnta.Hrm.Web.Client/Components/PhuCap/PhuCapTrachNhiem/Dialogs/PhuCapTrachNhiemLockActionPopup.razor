@namespace Vnta.Hrm.Web.Client.Components.PhuCap.PhuCapTrachNhiem

<DxPopup Visible="@Visible"
         VisibleChanged="OnVisibleChangedAsync"
         HeaderText="@Title"
         Width="min(36rem, calc(100vw - 2rem))"
         ShowCloseButton="@(!IsRefreshing)"
         ShowFooter="true"
         CloseOnEscape="@(!IsRefreshing)"
         CloseOnOutsideClick="false"
         FooterCssClass="responsibility-lock-popup-footer"
         CssClass="responsibility-lock-action-popup">
    <BodyContentTemplate>
        <div class="responsibility-lock-action-content">
            <div class="responsibility-lock-action-heading">
                <DxButton IconUrl="@(ShouldLock ? VntaDevExpressIcons.Lock : VntaDevExpressIcons.Unlock)"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Text"
                          Attributes="@DecorativeIconButtonAttributes" />
                <div class="responsibility-lock-action-prompt">@PromptText</div>
            </div>
            <div class="responsibility-lock-action-context">@ContextText</div>
            <div class="responsibility-lock-action-options">
                <button type="button"
                        class="@GetScopeCssClass(SelectedRowsScope)"
                        @onclick="@(() => SelectScopeAsync(SelectedRowsScope))"
                        disabled="@(!CanChooseSelectedRowsScope || IsRefreshing)">
                    <span class="responsibility-lock-action-title">Nhân viên đã chọn</span>
                    <span class="responsibility-lock-action-description">@SelectedRowsDescription</span>
                </button>
                <button type="button"
                        class="@GetScopeCssClass(WholePeriodScope)"
                        @onclick="@(() => SelectScopeAsync(WholePeriodScope))"
                        disabled="@IsRefreshing">
                    <span class="responsibility-lock-action-title">Toàn bộ kỳ @WholePeriodLabel</span>
                    <span class="responsibility-lock-action-description">@WholePeriodDescription</span>
                </button>
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="responsibility-lock-confirm-actions">
            <DxButton Text="Hủy"
                      Click="CloseAsync"
                      IconUrl="@VntaDevExpressIcons.Cancel"
                      CssClass="responsibility-lock-popup-action"
                      Enabled="@(!IsRefreshing)"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline" />
            <DxButton Text="@(ShouldLock ? "Khóa" : "Mở khóa")"
                      Click="ConfirmAsync"
                      IconUrl="@(ShouldLock ? VntaDevExpressIcons.Lock : VntaDevExpressIcons.Unlock)"
                      CssClass="responsibility-lock-popup-action"
                      Enabled="@CanConfirm"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained" />
        </div>
    </FooterContentTemplate>
</DxPopup>
