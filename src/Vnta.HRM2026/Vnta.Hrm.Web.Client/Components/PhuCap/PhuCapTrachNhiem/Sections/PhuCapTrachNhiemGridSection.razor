@using Vnta.Hrm.Application.PhuCap.PhuCapTrachNhiem
@namespace Vnta.Hrm.Web.Client.Components.PhuCap.PhuCapTrachNhiem

<div class="card responsibility-grid-card">
    <HrmLoadingPanel Visible="@IsLoading" IsContentBlocked="true" IsContentVisible="true" IndicatorVisible="true" IndicatorAreaVisible="true" Text="@LoadingText" CssClass="responsibility-loading-panel">
        <div class="responsibility-grid-content">
            <div class="responsibility-grid-header">
                <div class="responsibility-grid-header-main"><div class="responsibility-summary-strip">
                    <DxButtonGroup CssClass="responsibility-summary-button-group" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline" SelectionMode="ButtonGroupSelectionMode.Single" Enabled="@CanInteract"><Items>
                        @foreach (var badge in SummaryBadges)
                        { <DxButtonGroupItem Text="@($"{badge.ShortLabel} {badge.Count:N0}")" Tooltip="@badge.Label" CssClass="@($"responsibility-summary-button responsibility-summary-button-{badge.Key}")" Selected="@(badge.Key == ActiveSummaryBadgeKey)" Click="@(() => SummaryBadgeSelected.InvokeAsync(badge.Key))" /> }
                    </Items></DxButtonGroup>
                    <div class="responsibility-summary-amount" title="Tổng tiền phụ cấp trách nhiệm thực tế của danh sách đang hiển thị"><span class="responsibility-summary-amount-label">Tiền thực tế</span><strong class="responsibility-summary-amount-value">@FormatCurrency(TotalActualAllowanceAmount)</strong></div>
                </div></div>
                <div class="responsibility-grid-search"><DxSearchBox CssClass="responsibility-grid-searchbox" NullText="Tìm kiếm phụ cấp trách nhiệm" BindValueMode="BindValueMode.OnDelayedInput" InputDelay="500" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" Text="@SearchText" TextChanged="SearchTextChanged" Enabled="@CanInteract" /></div>
            </div>
            <DxGrid @ref="grid" Data="@Records" KeyFieldName="Id" CssClass="responsibility-grid" ShowSearchBox="false" PagerVisible="false" ShowAllRows="true" SkeletonRowsEnabled="true" ColumnResizeMode="GridColumnResizeMode.NextColumn" FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always" TextWrapEnabled="false" FocusedRowEnabled="true" HighlightRowOnHover="true" AllowSelectRowByClick="true" SelectionMode="GridSelectionMode.Multiple" SelectedDataItems="@SelectedDataItems" SelectedDataItemsChanged="SelectedDataItemsChanged">
                <Columns>
                    <DxGridSelectionColumn Width="3rem" />
                    <DxGridDataColumn Caption="STT" Width="4.5rem" MinWidth="72" AllowSort="false"><CellDisplayTemplate>@(CurrentPageIndex * PageSize + context.VisibleIndex + 1)</CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn Caption="Tác vụ" MinWidth="96" Width="6rem" AllowSort="false" TextAlignment="GridTextAlignment.Center" ShowInColumnChooser="false"><CellDisplayTemplate>
                        @{ var row = (PayrollResponsibilityAllowanceAbcItemDto)context.DataItem; }
                        <div class="responsibility-row-menu-host" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true"><DxDropDownButton CssClass="responsibility-row-menu-btn" IconCssClass="icon more-icon medium-icon" RenderStyle="ButtonRenderStyle.Link" DropDownToggleVisible="false" Enabled="@CanOperate" Tooltip="Tác vụ dòng phụ cấp trách nhiệm"><Items>
                            <DxDropDownButtonItem Text="Điều chỉnh" IconUrl="@VntaDevExpressIcons.Edit" Click="@(() => AdjustmentRequested.InvokeAsync(row))" Enabled="@CanAdjust(row)" />
                            <DxDropDownButtonItem Text="Chi tiết tính" IconUrl="@VntaDevExpressIcons.TaskList" Click="@(() => CalculationRequested.InvokeAsync(row))" Enabled="@CanViewCalculation(row)" />
                            <DxDropDownButtonItem Text="Làm mới" IconUrl="@VntaDevExpressIcons.Refresh" Click="@(() => RefreshRequested.InvokeAsync(row))" Enabled="@CanRefresh(row)" Tooltip="Làm mới dữ liệu tính toán của dòng phụ cấp trách nhiệm" />
                            <DxDropDownButtonItem Text="@(row.IsLocked ? "Mở khóa" : "Khóa")" IconUrl="@(row.IsLocked ? VntaDevExpressIcons.Unlock : VntaDevExpressIcons.Lock)" Click="@(() => LockToggleRequested.InvokeAsync(row))" Enabled="@CanToggleLock(row)" BeginGroup="true" Tooltip="@(row.IsLocked ? "Mở khóa dòng phụ cấp trách nhiệm" : "Khóa dòng phụ cấp trách nhiệm")" />
                            <DxDropDownButtonItem Text="Bảng công tháng" IconUrl="@VntaDevExpressIcons.TaskList" Click="@(() => MonthlyWorkRequested.InvokeAsync(row))" Enabled="@CanViewMonthlyWork(row)" Tooltip="Xem bảng công tháng của nhân viên" />
                        </Items></DxDropDownButton></div>
                    </CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn FieldName="EmployeeCode" Caption="Mã NV" MinWidth="120"><CellDisplayTemplate>@FormatOptional(((PayrollResponsibilityAllowanceAbcItemDto)context.DataItem).EmployeeCode)</CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn FieldName="EmployeeName" Caption="Nhân viên" MinWidth="180"><CellDisplayTemplate>@FormatOptional(((PayrollResponsibilityAllowanceAbcItemDto)context.DataItem).EmployeeName)</CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn FieldName="PositionName" Caption="Chức vụ" MinWidth="170"><CellDisplayTemplate>@{ var row = (PayrollResponsibilityAllowanceAbcItemDto)context.DataItem; }<span class="responsibility-grid-text" title="@FormatOptional(row.PositionName)">@FormatOptional(row.PositionName)</span></CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn FieldName="GradeName" Caption="Bậc trách nhiệm" MinWidth="170"><CellDisplayTemplate>@{ var row = (PayrollResponsibilityAllowanceAbcItemDto)context.DataItem; var gradeName = string.IsNullOrWhiteSpace(row.GradeName) ? "Không hưởng" : row.GradeName; }@if (string.IsNullOrWhiteSpace(row.GradeName)) { <span class="@GetYesNoStatusCssClass(false)" title="@gradeName">@gradeName</span> } else { <span class="responsibility-grid-text" title="@gradeName">@gradeName</span> }</CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn FieldName="ActualWorkDays" Caption="Công hợp lệ" MinWidth="110"><CellDisplayTemplate>@FormatWorkday(((PayrollResponsibilityAllowanceAbcItemDto)context.DataItem).ActualWorkDays)</CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn FieldName="StandardWorkDays" Caption="Công chuẩn" MinWidth="110"><CellDisplayTemplate>@FormatNumber(((PayrollResponsibilityAllowanceAbcItemDto)context.DataItem).StandardWorkDays)</CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn FieldName="AbcRating" Caption="ABC" MinWidth="90"><CellDisplayTemplate>@{ var row = (PayrollResponsibilityAllowanceAbcItemDto)context.DataItem; }<span class="@GetAbcStatusCssClass(row.AbcRating)">@GetAbcStatusText(row.AbcRating)</span></CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn FieldName="MonthlyPerformanceBonusAmount" Caption="THS (%)" MinWidth="100"><CellDisplayTemplate>@FormatPercentage(((PayrollResponsibilityAllowanceAbcItemDto)context.DataItem).MonthlyPerformanceBonusAmount)</CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn FieldName="IsPerformanceBonusExcluded" Caption="Áp dụng THS" MinWidth="130"><CellDisplayTemplate>@{ var row = (PayrollResponsibilityAllowanceAbcItemDto)context.DataItem; }<span class="@GetYesNoStatusCssClass(!row.IsPerformanceBonusExcluded)">@GetPerformanceBonusStatusText(row.IsPerformanceBonusExcluded)</span></CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn FieldName="StandardResponsibilityAllowanceAmount" Caption="Tiền chuẩn" MinWidth="130"><CellDisplayTemplate>@FormatCurrency(((PayrollResponsibilityAllowanceAbcItemDto)context.DataItem).StandardResponsibilityAllowanceAmount)</CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn FieldName="ActualResponsibilityAllowanceAmount" Caption="Tiền thực tế" MinWidth="140"><CellDisplayTemplate><span class="hrm-grid-amount hrm-grid-amount--total">@FormatCurrency(((PayrollResponsibilityAllowanceAbcItemDto)context.DataItem).ActualResponsibilityAllowanceAmount)</span></CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn FieldName="IsLocked" Caption="Khóa" MinWidth="90"><CellDisplayTemplate>@{ var row = (PayrollResponsibilityAllowanceAbcItemDto)context.DataItem; }<span class="@GetYesNoStatusCssClass(!row.IsLocked)">@GetLockStatusText(row.IsLocked)</span></CellDisplayTemplate></DxGridDataColumn>
                </Columns>
                <EmptyDataAreaTemplate><div class="empty-state"><div class="state-title">@EmptyStateTitle</div><div class="state-message">@EmptyStateMessage</div><DxButton Text="@EmptyStateActionText" Click="EmptyStateActionRequested" RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ButtonRenderStyleMode.Contained" /></div></EmptyDataAreaTemplate>
            </DxGrid>
            <div class="responsibility-pager" aria-label="Điều hướng trang phụ cấp trách nhiệm"><div class="responsibility-pager-summary">@PagerSummaryText</div>@if (CanBrowsePages) { <DxPager PageCount="@TotalPageCount" ActivePageIndex="@CurrentPageIndex" ActivePageIndexChanged="ActivePageIndexChanged" NavigationMode="PagerNavigationMode.NumericButtons" VisibleNumericButtonCount="7" /> }<div class="responsibility-page-size"><span>Hiển thị</span><DxComboBox TData="int" TValue="int" Data="@PageSizeOptions" Value="@PageSize" ValueChanged="PageSizeChanged" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never" Enabled="@CanChangeFilters" CssClass="responsibility-page-size-editor" /><span>dòng/trang</span></div></div>
        </div>
    </HrmLoadingPanel>
</div>
