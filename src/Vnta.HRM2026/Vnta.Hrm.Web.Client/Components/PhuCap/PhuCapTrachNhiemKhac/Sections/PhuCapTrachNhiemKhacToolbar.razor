@using DevExpress.Blazor
@using Vnta.Hrm.Web.Client.Components.PhuCap.PhuCapTrachNhiemKhac.Models

<div class="card toolbar">
    <DxToolbar Title="Phụ cấp trách nhiệm khác" CssClass="toolbar" ItemRenderStyleMode="ToolbarRenderStyleMode.Plain">
        <DxToolbarItem Alignment="ToolbarItemAlignment.Right" CssClass="toolbar-filter-item" Tooltip="Chọn năm áp dụng">
            <Template>
                <div class="custom-item toolbar-filter-editor">
                    <span class="toolbar-filter-label">Năm</span>
                    <DxSpinEdit T="int" Value="@Year" ValueChanged="YearChanged" MinValue="@MinimumYear" MaxValue="@MaximumYear" Increment="1" ShowSpinButtons="true" Enabled="@CanChangeFilters" CssClass="toolbar-filter-year" />
                </div>
            </Template>
        </DxToolbarItem>
        <DxToolbarItem Alignment="ToolbarItemAlignment.Right" CssClass="toolbar-filter-item" Tooltip="Chọn tháng áp dụng">
            <Template>
                <div class="custom-item toolbar-filter-editor">
                    <span class="toolbar-filter-label">Tháng</span>
                    <DxComboBox TData="OtherResponsibilityAllowanceMonthOption" TValue="int" @key="Year" Data="@AvailableMonths" Value="@Month" ValueChanged="MonthChanged" ValueFieldName="@nameof(OtherResponsibilityAllowanceMonthOption.Value)" TextFieldName="@nameof(OtherResponsibilityAllowanceMonthOption.Text)" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never" Enabled="@CanChangeFilters" CssClass="toolbar-filter-month" />
                </div>
            </Template>
        </DxToolbarItem>
        <DxToolbarItem Text="Xem" Click="ViewRequested" Enabled="@CanView" Alignment="ToolbarItemAlignment.Right" Tooltip="Chuẩn bị và tải dữ liệu phụ cấp trách nhiệm khác theo kỳ lương đang chọn" IconUrl="@VntaDevExpressIcons.FolderOpenArrowImport" />
        <DxToolbarItem Alignment="ToolbarItemAlignment.Right" Tooltip="Nhóm các hành động thao tác trên dữ liệu phụ cấp trách nhiệm khác">
            <Template>
                <div class="custom-item">
                    <DxDropDownButton Text="Hành động" IconUrl="@VntaDevExpressIcons.TaskList" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline" Enabled="@CanOpenActionsMenu" CssClass="toolbar-action-dropdown">
                        <Items>
                            <DxDropDownButtonItem Text="Tính lại" IconUrl="@VntaDevExpressIcons.Refresh" Click="RecalculateRequested" Enabled="@CanUseAppliedPeriodActions" />
                            <DxDropDownButtonItem Text="Khóa" IconUrl="@VntaDevExpressIcons.Lock" Click="LockRequested" Enabled="@CanUseAppliedPeriodActions" />
                            <DxDropDownButtonItem Text="Mở khóa" IconUrl="@VntaDevExpressIcons.Unlock" Click="UnlockRequested" Enabled="@CanUseAppliedPeriodActions" />
                        </Items>
                    </DxDropDownButton>
                </div>
            </Template>
        </DxToolbarItem>
        <DxToolbarItem Text="Quy tắc" Click="RulesRequested" Enabled="@CanOpenRules" Alignment="ToolbarItemAlignment.Right" Tooltip="Xem quy tắc phụ cấp trách nhiệm khác" IconUrl="@VntaDevExpressIcons.TextBoxDescription" />
        <DxToolbarItem Text="Xuất dữ liệu" Enabled="@CanExport" Alignment="ToolbarItemAlignment.Right" Tooltip="Xuất dữ liệu phụ cấp trách nhiệm khác đang hiển thị" IconUrl="@VntaDevExpressIcons.Export">
            <Items>
                <DxToolbarItem Text="Xuất Excel" Click="ExportExcelRequested" Enabled="@CanExport" Tooltip="Xuất toàn bộ dữ liệu phụ cấp trách nhiệm khác ra Excel" IconUrl="@VntaDevExpressIcons.Excel" />
                <DxToolbarItem Text="Xuất PDF" Click="ExportPdfRequested" Enabled="@CanExport" Tooltip="Xuất toàn bộ dữ liệu phụ cấp trách nhiệm khác ra PDF" IconUrl="@VntaDevExpressIcons.Pdf" />
                <DxToolbarItem Text="Xuất dòng đã chọn ra Excel" Click="ExportSelectedExcelRequested" Enabled="@CanExportSelected" Tooltip="Xuất các dòng phụ cấp trách nhiệm khác đã chọn ra Excel" IconUrl="@VntaDevExpressIcons.Excel" />
                <DxToolbarItem Text="Xuất dòng đã chọn ra PDF" Click="ExportSelectedPdfRequested" Enabled="@CanExportSelected" Tooltip="Xuất các dòng phụ cấp trách nhiệm khác đã chọn ra PDF" IconUrl="@VntaDevExpressIcons.Pdf" />
            </Items>
        </DxToolbarItem>
        <DxToolbarItem Tooltip="Chọn cột hiển thị trong danh sách phụ cấp trách nhiệm khác" Alignment="ToolbarItemAlignment.Right" Enabled="@CanOpenActionsMenu" Click="ColumnChooserRequested" IconUrl="@VntaDevExpressIcons.ColumnChooser" />
    </DxToolbar>
</div>
