@page "/admin/employee-accounts"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Vnta.Hrm.Application.Common.Security
@using Vnta.Hrm.Web.Client.Models.Security

@attribute [Authorize(Policy = InternalAccountPolicies.EmployeeAccountAdministration)]
@rendermode InteractiveServer

<PageTitle>Quản lý tài khoản nhân viên</PageTitle>

<div class="content-root">
    <div class="card toolbar">
        <DxToolbar Title="Quản lý tài khoản nhân viên"
                   ItemRenderStyleMode="ToolbarRenderStyleMode.Plain">
            <DxToolbarItem Text="Mở tài khoản"
                           Click="OnOpenAccountClick"
                           Enabled="@CanOpenAccount"
                           Alignment="ToolbarItemAlignment.Right"
                           Tooltip="Mở tài khoản nội bộ cho nhân viên đã chọn"
                           IconUrl="@VntaDevExpressIcons.Add" />
            <DxToolbarItem Text="Đặt lại mật khẩu"
                           Click="OnResetPasswordClick"
                           Enabled="@CanResetPassword"
                           Alignment="ToolbarItemAlignment.Right"
                           Tooltip="Đặt lại mật khẩu tạm cho tài khoản nhân viên đã chọn" />
            <DxToolbarItem Text="Kích hoạt lại"
                           Click="OnActivateClickAsync"
                           Enabled="@CanActivate"
                           Alignment="ToolbarItemAlignment.Right"
                           Tooltip="Kích hoạt lại tài khoản nhân viên đã bị ngưng dùng"
                           IconUrl="@VntaDevExpressIcons.Save" />
            <DxToolbarItem Text="Ngưng kích hoạt"
                           Click="OnDeactivateClickAsync"
                           Enabled="@CanDeactivate"
                           Alignment="ToolbarItemAlignment.Right"
                           Tooltip="Ngưng sử dụng tài khoản nhân viên đang kích hoạt"
                           IconUrl="@VntaDevExpressIcons.Delete" />
            <DxToolbarItem Tooltip="Làm mới danh sách tài khoản nhân viên"
                           Enabled="@CanReload"
                           Click="ReloadAsync"
                           Alignment="ToolbarItemAlignment.Right"
                           IconUrl="@VntaDevExpressIcons.Refresh" />
            <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                           CssClass="search-textbox-item"
                           Tooltip="Tìm kiếm nhân viên hoặc tài khoản">
                <Template>
                    <div class="custom-item">
                        <DxSearchBox CssClass="search-textbox"
                                     NullText="Tìm mã nhân viên, họ tên, tài khoản"
                                     BindValueMode="BindValueMode.OnInput"
                                     ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                     @bind-Text="SearchText" />
                    </div>
                </Template>
            </DxToolbarItem>
        </DxToolbar>
    </div>

    <div class="employee-account-root">
    @if(HasLoadError)
    {
        <div class="card error-state">
            <div class="state-title">Không thể tải danh sách tài khoản nhân viên</div>
            <div class="state-message">@LoadErrorMessage</div>
            <DxButton Text="Thử lại"
                      Click="ReloadAsync"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained" />
        </div>
    }
    else
    {
        <div class="card employee-account-grid-card">
            <HrmLoadingPanel Visible="@IsLoading"
                             IsContentBlocked="true"
                             IsContentVisible="true"
                             IndicatorVisible="true"
                             IndicatorAreaVisible="true"
                             Text="@LoadingText">
                <DxGrid @ref="Grid"
                        Data="@Records"
                        KeyFieldName="EmployeeId"
                        CssClass="employee-account-grid"
                        SearchText="@SearchText"
                        PageSize="50"
                        PagerPosition="GridPagerPosition.Bottom"
                        PagerSummaryVisible="true"
                        PageSizeSelectorVisible="true"
                        PageSizeSelectorItems="@(new int[] { 25, 50, 100 })"
                        SkeletonRowsEnabled="true"
                        ColumnResizeMode="GridColumnResizeMode.NextColumn"
                        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
                        TextWrapEnabled="false"
                        FocusedRowEnabled="true"
                        HighlightRowOnHover="true"
                        AllowSelectRowByClick="true"
                        SelectionMode="GridSelectionMode.Multiple"
                        SelectedDataItems="@SelectedDataItems"
                        SelectedDataItemsChanged="@OnSelectedDataItemsChanged">
                    <Columns>
                        <DxGridSelectionColumn Width="3rem" />
                        <DxGridDataColumn Caption="STT" Width="4.5rem" MinWidth="72" AllowSort="false">
                            <CellDisplayTemplate>
                                @(context.VisibleIndex + 1)
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="EmployeeCode" Caption="Mã nhân viên" Width="130" MinWidth="130" />
                        <DxGridDataColumn FieldName="FullName" Caption="Họ tên" MinWidth="180" />
                        <DxGridDataColumn FieldName="DepartmentPath" Caption="Phòng ban" MinWidth="240" />
                        <DxGridDataColumn FieldName="PositionName" Caption="Chức vụ" MinWidth="160" />
                        <DxGridDataColumn FieldName="UserName" Caption="Tài khoản" MinWidth="150">
                            <CellDisplayTemplate>
                                @{
                                    var row = (EmployeeAccountRecord)context.DataItem;
                                }
                                @(string.IsNullOrWhiteSpace(row.UserName) ? "Chưa có" : row.UserName)
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="RoleNamesText" Caption="Vai trò" MinWidth="170" />
                        <DxGridDataColumn FieldName="ApprovalStatusText" Caption="Phê duyệt" MinWidth="130" />
                        <DxGridDataColumn FieldName="AccountStateText" Caption="Kích hoạt" MinWidth="130" />
                    </Columns>
                    <EmptyDataAreaTemplate>
                        <div class="empty-state">
                            <div class="state-title">Chưa có dữ liệu tài khoản nhân viên</div>
                            <div class="state-message">Danh sách nhân viên và tài khoản nội bộ sẽ hiển thị tại đây.</div>
                        </div>
                    </EmptyDataAreaTemplate>
                </DxGrid>
            </HrmLoadingPanel>
        </div>
    }
    </div>
</div>

<DxPopup Visible="@IsOpenAccountPopupVisible"
         VisibleChanged="OnOpenAccountPopupVisibleChanged"
         HeaderText="Mở tài khoản nhân viên"
         Width="min(42rem, calc(100vw - 2rem))"
         ShowCloseButton="@(!IsSaving)"
         ShowFooter="true"
         CloseOnOutsideClick="false">
    <BodyContentTemplate Context="popupBody">
        @if(OpenAccountModel is not null)
        {
            <EditForm EditContext="@OpenAccountEditContext" OnValidSubmit="OnOpenAccountRequested" Context="openAccountForm">
                <DataAnnotationsValidator />
                <DxFormLayout CaptionPosition="CaptionPosition.Vertical">
                    <DxFormLayoutItem Caption="Nhân viên" ColSpanMd="12">
                        <div>@OpenAccountModel.EmployeeCode - @OpenAccountModel.EmployeeName</div>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Tài khoản đăng nhập" ColSpanMd="6">
                        <DxTextBox Text="@OpenAccountModel.EmployeeCode"
                                   ReadOnly="true"
                                   ValidationEnabled="false" />
                        <div class="form-text">Hệ thống tự dùng mã nhân viên làm tài khoản đăng nhập.</div>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Mật khẩu tạm" ColSpanMd="6">
                        <DxTextBox @bind-Text="OpenAccountModel.TemporaryPassword"
                                   Password="true"
                                   ShowValidationIcon="true" />
                        <ValidationMessage For="@(() => OpenAccountModel.TemporaryPassword)" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Vai trò" ColSpanMd="6">
                        <DxComboBox TData="RoleOption"
                                    TValue="string"
                                    Data="@RoleOptions"
                                    @bind-Value="OpenAccountModel.RoleName"
                                    ValueFieldName="@nameof(RoleOption.Value)"
                                    TextFieldName="@nameof(RoleOption.Text)"
                                    ShowValidationIcon="true"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never" />
                        <ValidationMessage For="@(() => OpenAccountModel.RoleName)" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Mức truy cập" ColSpanMd="6">
                        <DxTextBox @bind-Text="OpenAccountModel.AccessLevel"
                                   NullText="Mức truy cập"
                                   ShowValidationIcon="true" />
                    </DxFormLayoutItem>
                </DxFormLayout>
                <ValidationSummary class="validation-summary" />
                @if(!string.IsNullOrWhiteSpace(EditErrorMessage))
                {
                    <div class="form-error-message">@EditErrorMessage</div>
                }
            </EditForm>
        }
    </BodyContentTemplate>
    <FooterContentTemplate Context="popupFooter">
        <DxButton Text="Mở tài khoản"
                  Click="OnSaveOpenAccountClickAsync"
                  Enabled="@CanSubmitOpenAccount"
                  RenderStyle="ButtonRenderStyle.Primary"
                  RenderStyleMode="ButtonRenderStyleMode.Contained" />
        <DxButton Text="Hủy"
                  Click="OnCancelOpenAccountClickAsync"
                  Enabled="@(!IsSaving)" />
    </FooterContentTemplate>
</DxPopup>

<DxPopup Visible="@IsResetPasswordPopupVisible"
         VisibleChanged="OnResetPasswordPopupVisibleChanged"
         HeaderText="Đặt lại mật khẩu tạm"
         Width="min(36rem, calc(100vw - 2rem))"
         ShowCloseButton="@(!IsSaving)"
         ShowFooter="true"
         CloseOnOutsideClick="false">
    <BodyContentTemplate Context="popupBody">
        <EditForm EditContext="@ResetPasswordEditContext" Context="resetPasswordForm">
            <DataAnnotationsValidator />
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical">
                <DxFormLayoutItem Caption="Nhân viên" ColSpanMd="12">
                    <div>@ResetPasswordEmployeeDisplay</div>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Mật khẩu tạm mới" ColSpanMd="12">
                    <DxTextBox @bind-Text="ResetPasswordModel.TemporaryPassword"
                               Password="true"
                               ShowValidationIcon="true" />
                    <ValidationMessage For="@(() => ResetPasswordModel.TemporaryPassword)" />
                </DxFormLayoutItem>
            </DxFormLayout>
            <ValidationSummary class="validation-summary" />
            @if(!string.IsNullOrWhiteSpace(EditErrorMessage))
            {
                <div class="form-error-message">@EditErrorMessage</div>
            }
        </EditForm>
    </BodyContentTemplate>
    <FooterContentTemplate Context="popupFooter">
        <DxButton Text="Xác nhận đặt lại"
                  Click="OnConfirmResetPasswordClickAsync"
                  Enabled="@CanSubmitResetPassword"
                  RenderStyle="ButtonRenderStyle.Primary"
                  RenderStyleMode="ButtonRenderStyleMode.Contained" />
        <DxButton Text="Hủy"
                  Click="OnCancelResetPasswordClickAsync"
                  Enabled="@(!IsSaving)" />
    </FooterContentTemplate>
</DxPopup>
