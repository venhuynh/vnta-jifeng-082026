@using Microsoft.AspNetCore.Components.Forms
@using Vnta.Hrm.Web.Client.Components.TienDoTrienKhai.Models

<DxPopup Visible="@Visible"
         VisibleChanged="OnVisibleChangedAsync"
         HeaderText="@Title"
         Width="min(46rem, calc(100vw - 2rem))"
         ShowCloseButton="@(!IsSaving)"
         ShowFooter="true"
         CloseOnEscape="@(!IsSaving)"
         CloseOnOutsideClick="false"
         CssClass="implementation-progress-edit-popup">
    <BodyContentTemplate Context="editPopupBody">
        <div class="implementation-progress-edit-content">
            <EditForm EditContext="@EditContext" Context="editFormContext">
                <DataAnnotationsValidator />
                <DxFormLayout CaptionPosition="CaptionPosition.Vertical">
                    <DxFormLayoutItem Caption="Mã hạng mục" ColSpanMd="4">
                        <DxTextBox @bind-Text="Model.Code"
                                   MaxLength="32"
                                   ShowValidationIcon="true"
                                   Enabled="@CanEditFields" />
                        <ValidationMessage For="@(() => Model.Code)" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Phân hệ" ColSpanMd="8">
                        <DxTextBox @bind-Text="Model.Module"
                                   MaxLength="120"
                                   ShowValidationIcon="true"
                                   Enabled="@CanEditFields" />
                        <ValidationMessage For="@(() => Model.Module)" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Hạng mục triển khai" ColSpanMd="12">
                        <DxTextBox @bind-Text="Model.WorkItem"
                                   MaxLength="250"
                                   ShowValidationIcon="true"
                                   Enabled="@CanEditFields" />
                        <ValidationMessage For="@(() => Model.WorkItem)" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Phụ trách" ColSpanMd="6">
                        <DxTextBox @bind-Text="Model.Owner"
                                   MaxLength="120"
                                   ShowValidationIcon="true"
                                   Enabled="@CanEditFields" />
                        <ValidationMessage For="@(() => Model.Owner)" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Trạng thái" ColSpanMd="6">
                        <DxComboBox TData="ProjectImplementationProgressStatusDefinition"
                                    TValue="ProjectImplementationProgressStatus"
                                    Data="@StatusOptions"
                                    @bind-Value="Model.Status"
                                    ValueFieldName="@nameof(ProjectImplementationProgressStatusDefinition.Value)"
                                    TextFieldName="@nameof(ProjectImplementationProgressStatusDefinition.Label)"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    Enabled="@CanEditFields" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Ngày bắt đầu" ColSpanMd="4">
                        <DxDateEdit @bind-Date="Model.StartDate"
                                    DisplayFormat="dd/MM/yyyy"
                                    ShowValidationIcon="true"
                                    Enabled="@CanEditFields" />
                        <ValidationMessage For="@(() => Model.StartDate)" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Hạn hoàn thành" ColSpanMd="4">
                        <DxDateEdit @bind-Date="Model.DueDate"
                                    DisplayFormat="dd/MM/yyyy"
                                    ShowValidationIcon="true"
                                    Enabled="@CanEditFields" />
                        <ValidationMessage For="@(() => Model.DueDate)" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Tiến độ (%)" ColSpanMd="4">
                        <DxSpinEdit T="int"
                                    @bind-Value="Model.ProgressPercent"
                                    MinValue="0"
                                    MaxValue="100"
                                    Increment="5"
                                    ShowSpinButtons="true"
                                    ShowValidationIcon="true"
                                    Enabled="@CanEditFields" />
                        <ValidationMessage For="@(() => Model.ProgressPercent)" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Ghi chú" ColSpanMd="12">
                        <DxMemo @bind-Text="Model.Note"
                                MaxLength="1000"
                                Rows="4"
                                ShowValidationIcon="true"
                                Enabled="@CanEditFields" />
                        <ValidationMessage For="@(() => Model.Note)" />
                    </DxFormLayoutItem>
                </DxFormLayout>
            </EditForm>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="implementation-progress-edit-actions">
            <DxButton Text="Hủy"
                      Click="CloseAsync"
                      IconUrl="@VntaDevExpressIcons.Cancel"
                      Enabled="@(!IsSaving)"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline" />
            <DxButton Text="Lưu"
                      Click="SaveAsync"
                      IconUrl="@VntaDevExpressIcons.Save"
                      Enabled="@CanSave"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained" />
        </div>
    </FooterContentTemplate>
</DxPopup>
