@using Vnta.Hrm.Web.Client.Components.TienDoTrienKhai.Models

<DxGrid @ref="Grid"
        Data="@Records"
        KeyFieldName="Id"
        CssClass="implementation-progress-grid"
        ShowSearchBox="false"
        PagerVisible="false"
        PageSize="@PageSize"
        SkeletonRowsEnabled="true"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        TextWrapEnabled="false"
        FocusedRowEnabled="true"
        HighlightRowOnHover="true">
    <Columns>
        <DxGridDataColumn Caption="STT" Width="4.5rem" MinWidth="72" AllowSort="false">
            <CellDisplayTemplate>@(StartRecordIndex + context.VisibleIndex)</CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn Caption="Tác vụ" MinWidth="96" Width="6rem" AllowSort="false" TextAlignment="GridTextAlignment.Center" ShowInColumnChooser="false">
            <CellDisplayTemplate>
                @{ var item = (ProjectImplementationProgressItem)context.DataItem; }
                <div class="implementation-progress-row-menu-host" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                    <DxDropDownButton CssClass="implementation-progress-row-menu-btn"
                                      IconCssClass="icon more-icon medium-icon"
                                      RenderStyle="ButtonRenderStyle.Link"
                                      DropDownToggleVisible="false"
                                      Enabled="@CanOperate"
                                      Tooltip="Tác vụ hạng mục triển khai">
                        <Items>
                            <DxDropDownButtonItem Text="Cập nhật"
                                                  IconUrl="@VntaDevExpressIcons.Edit"
                                                  Click="@(() => EditRequested.InvokeAsync(item))"
                                                  Tooltip="Cập nhật thông tin và tiến độ của hạng mục" />
                        </Items>
                    </DxDropDownButton>
                </div>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="Code" Caption="Mã" Width="6.5rem" MinWidth="96" />
        <DxGridDataColumn FieldName="WorkItem" Caption="Hạng mục triển khai" MinWidth="260">
            <CellDisplayTemplate>
                @{ var item = (ProjectImplementationProgressItem)context.DataItem; }
                <span class="implementation-progress-work-item" title="@item.WorkItem">@item.WorkItem</span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="Module" Caption="Phân hệ" MinWidth="170" />
        <DxGridDataColumn FieldName="Owner" Caption="Phụ trách" MinWidth="150" />
        <DxGridDataColumn FieldName="StartDate" Caption="Bắt đầu" DisplayFormat="dd/MM/yyyy" Width="8.5rem" MinWidth="130" />
        <DxGridDataColumn FieldName="DueDate" Caption="Hạn hoàn thành" DisplayFormat="dd/MM/yyyy" Width="9.5rem" MinWidth="145" />
        <DxGridDataColumn FieldName="ProgressPercent" Caption="Tiến độ" Width="11rem" MinWidth="165" TextAlignment="GridTextAlignment.Right">
            <CellDisplayTemplate>
                @{ var item = (ProjectImplementationProgressItem)context.DataItem; }
                <div class="implementation-progress-value" title="@($"{item.ProgressPercent}% hoàn thành")">
                    <DxProgressBar CssClass="implementation-progress-bar"
                                   MaxValue="100"
                                   Value="@item.ProgressPercent"
                                   ShowLabel="false" />
                    <span class="@ProgressValueCssClass(item.ProgressPercent)">@item.ProgressPercent%</span>
                </div>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="Status" Caption="Trạng thái" Width="9.5rem" MinWidth="145">
            <CellDisplayTemplate>
                @{ var item = (ProjectImplementationProgressItem)context.DataItem; }
                <span class="@StatusCssClass(item.Status)">@StatusLabel(item.Status)</span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="Note" Caption="Ghi chú" MinWidth="220" />
    </Columns>
    <EmptyDataAreaTemplate>
        <div class="empty-state">
            <div class="state-title">@EmptyStateTitle</div>
            <div class="state-message">@EmptyStateMessage</div>
            <DxButton Text="@EmptyStateActionText"
                      Click="EmptyStateActionRequested"
                      IconUrl="@VntaDevExpressIcons.Reset"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained" />
        </div>
    </EmptyDataAreaTemplate>
</DxGrid>
