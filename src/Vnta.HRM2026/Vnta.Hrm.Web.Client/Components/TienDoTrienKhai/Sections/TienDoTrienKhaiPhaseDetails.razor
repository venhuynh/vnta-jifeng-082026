@using Vnta.Hrm.Web.Client.Components.TienDoTrienKhai.Models

<section class="implementation-progress-phase-details" aria-labelledby="@DetailsTitleId">
    <header class="implementation-progress-phase-details-header">
        <div>
            <p>Chi tiết thực hiện</p>
            <h4 id="@DetailsTitleId">Giai đoạn @Phase.Sequence</h4>
        </div>
        <div class="implementation-progress-phase-details-meta">
            @if(Phase.StartDate is { } startDate)
            {
                <span>Bắt đầu <strong>@FormatDate(startDate)</strong></span>
            }
            <span><strong>@Phase.DetailedDurationWeeks/@Phase.DurationWeeks</strong> tuần đã mô tả</span>
        </div>
    </header>

    <div class="implementation-progress-milestone-table-scroll">
        <table class="implementation-progress-milestone-table">
            <caption>Chi tiết các mốc công việc của giai đoạn @Phase.Sequence</caption>
            <thead>
                <tr>
                    <th scope="col">Mốc</th>
                    <th scope="col">VNS</th>
                    <th scope="col">JIFENG</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var milestone in Phase.Milestones)
                {
                    <tr @key="milestone.Code">
                        <th scope="row">
                            <span class="implementation-progress-milestone-code">@milestone.Code</span>
                            <span class="implementation-progress-milestone-title">@milestone.Title</span>
                            <span class="implementation-progress-milestone-duration">Thời gian: @milestone.DurationWeeks tuần</span>
                        </th>
                        <td>
                            <ul>
                                @foreach(var item in milestone.VnsItems)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </td>
                        <td>
                            @if(!string.IsNullOrWhiteSpace(milestone.JifengLeadIn))
                            {
                                <p class="implementation-progress-jifeng-lead-in">@milestone.JifengLeadIn</p>
                            }
                            <ul>
                                @foreach(var item in milestone.JifengItems)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if(Phase.RemainingDurationWeeks > 0)
    {
        <p class="implementation-progress-phase-remaining-detail">
            <span aria-hidden="true"></span>
            <span><strong>@Phase.RemainingDurationWeeks tuần còn lại</strong> của giai đoạn chưa có nội dung chi tiết.</span>
        </p>
    }
</section>
