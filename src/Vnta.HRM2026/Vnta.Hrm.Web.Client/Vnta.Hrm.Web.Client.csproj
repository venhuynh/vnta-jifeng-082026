<?xml version="1.0" encoding="utf-8"?><Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>False</EnableDefaultItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <RootNamespace>Vnta.Hrm.Web.Client</RootNamespace>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">2026.07</ApplicationVersion>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <ReleaseDate Condition="'$(ReleaseDate)' == ''">Chưa phát hành</ReleaseDate>
    <!-- Build thông thường của solution không cần native WASM và không nên bắt buộc workload wasm-tools.
         Nếu cần native WASM/AOT, có thể bật lại bằng /p:WasmBuildNative=true ở publish hoặc CI riêng. -->
    <WasmBuildNative Condition="'$(WasmBuildNative)' == ''">false</WasmBuildNative>
    <!-- Ẩn warning WASM0001 do package DevExpress printing nội bộ phát ra khi quét P/Invoke cho browser-wasm native build. -->
    <NoWarn>$(NoWarn);WASM0001</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ApplicationVersion" Value="$(ApplicationVersion)" />
    <AssemblyMetadata Include="BuildNumber" Value="$(BuildNumber)" />
    <AssemblyMetadata Include="ReleaseDate" Value="$(ReleaseDate)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="DevExtreme.AspNet.Data" />
    <PackageReference Include="DevExpress.Blazor.PivotTable" />
    <PackageReference Include="DevExpress.PivotGrid.Core" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.Blazor" VersionOverride="26.1.3" />
    <PackageReference Include="DevExpress.Images.Blazor" VersionOverride="26.1.3" />
    <PackageReference Include="DevExpress.AIIntegration.Blazor.Chat" VersionOverride="26.1.3" />
    <PackageReference Include="DevExpress.AIIntegration.OpenAI" VersionOverride="26.1.3" />
    <PackageReference Include="DevExpress.Drawing.Skia" VersionOverride="26.1.3" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    
    
    
	  
    
    
    
    
    
    
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vnta.Hrm.Application\Vnta.Hrm.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="obj/**/*.cs;.artifacts/**/*.cs;artifacts/**/*.cs;bin/**/*.cs" />
    <Content Include="Components\**\*.razor" />
    <Content Include="Components\**\*.css" />
    <EmbeddedResource Include="Resources\**\*.resx" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Services\DataProviders\PhuCap\LuongCanBan\" />
    <Folder Include="Services\DataProviders\TinhLuong\" />
    <Folder Include="Services\DataProviders\PhuCap\PhuCapTongHop\" />
  </ItemGroup>
</Project>

