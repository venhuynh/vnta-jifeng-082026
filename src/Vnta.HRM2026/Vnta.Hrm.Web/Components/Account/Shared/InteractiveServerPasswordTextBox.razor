@using Vnta.Hrm.Web.Client.Services.Ui
@rendermode InteractiveServer

<div class="password-textbox-container">
    <DxTextBox name="@Name"
               Password="@(!isPasswordVisible)"
               CssClass="@TextBoxCssClass"
               ShowValidationIcon="true"
               @bind-Text="@text"
               Enabled="@Enabled"
               NullText="@NullText"
               @attributes="Attributes" />
    <DxButton IconUrl="@VntaDevExpressIcons.View"
              CssClass="password-visibility-button"
              Click="@TogglePasswordVisibility"
              Enabled="@Enabled"
              RenderStyle="ButtonRenderStyle.None"
              Attributes="@VisibilityButtonAttributes" />
</div>

@code {
    private bool isPasswordVisible;
    private bool isInitialized;
    private string? text;

    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public string? NullText { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }

    private string TextBoxCssClass => string.IsNullOrWhiteSpace(CssClass)
        ? "password-textbox"
        : $"{CssClass} password-textbox";

    private string VisibilityTooltip => isPasswordVisible ? "Ẩn mật khẩu" : "Hiển thị mật khẩu";

    private Dictionary<string, object> VisibilityButtonAttributes => new()
    {
        ["aria-label"] = VisibilityTooltip,
        ["aria-pressed"] = isPasswordVisible.ToString().ToLowerInvariant(),
        ["title"] = VisibilityTooltip
    };

    protected override void OnParametersSet() {
        if (!isInitialized) {
            text = Value;
            isInitialized = true;
        }
    }

    private void TogglePasswordVisibility() => isPasswordVisible = !isPasswordVisible;
}
