@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<DxTabs @bind-ActiveTabIndex="ActiveTabIndex">
    <DxTab TabIconCssClass="tab-icon icon-profile" Text="Hồ sơ" Click="@(() => NavigationManager.NavigateTo("Account/Manage"))"/>
    <DxTab TabIconCssClass="tab-icon icon-password" Text="Mật khẩu" Click="@(() => NavigationManager.NavigateTo("Account/Manage/ChangePassword"))"/>
    <DxTab TabIconCssClass="tab-icon icon-two-factor" Text="Xác thực hai lớp" Click="@(() => NavigationManager.NavigateTo("Account/Manage/TwoFactorAuthentication"))"/>
    <DxTab TabIconCssClass="tab-icon icon-personal" Text="Dữ liệu cá nhân" Click="@(() => NavigationManager.NavigateTo("Account/Manage/PersonalData"))"/>
</DxTabs>

@code {
    int ActiveTabIndex { get; set; }

    protected override void OnInitialized() {
        if(NavigationManager.Uri.Contains("Account/Manage/ChangePassword")) ActiveTabIndex = 1;
        if(NavigationManager.Uri.Contains("Account/Manage/TwoFactorAuthentication")) ActiveTabIndex = 2;
        if(NavigationManager.Uri.Contains("Account/Manage/PersonalData")) ActiveTabIndex = 3;
    }
}
