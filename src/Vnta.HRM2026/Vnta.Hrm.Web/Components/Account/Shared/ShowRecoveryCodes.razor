<StatusMessage Message="@StatusMessage" />
<div class="title">
    <div class="title-content-text-secondary">Mã khôi phục</div>
</div>
<div class="manage-content">
    <div>Hãy lưu các mã này ở nơi an toàn.</div>
    <div>Nếu mất thiết bị và không còn mã khôi phục, bạn có thể mất quyền truy cập tài khoản.</div>
    <div class="codes">
        @foreach(var recoveryCode in RecoveryCodes) {
            <div>
                <code class="recovery-code">@recoveryCode</code>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
