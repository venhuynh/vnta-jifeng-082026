{
  "ConnectionStrings": {
    "Postgres": "",
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Information"
      }
    },
    "LogPath": "Logs/jifeng-hrm",
    "RetainedFileCountLimit": 7,
    "FileSizeLimitBytes": 104857600
  },
  "AdmsGateway": {
    "BaseUrl": "",
    "HubPath": "/hubs/adms-monitor",
    "ActivityBufferLimit": 50,
    "RawBufferLimit": 50,
    "RawPanelEventLimit": 50,
    "DeviceOfflineTimeoutSeconds": 180
  },
  "AttendanceWorkdaySummary": {
    "EnableDailyOvertimeRegistrationCheck": false
  },
  "DatabaseStartup": {
    "AutoMigrateOnStartup": true,
    "EnableSchemaGuards": false
  }
}
