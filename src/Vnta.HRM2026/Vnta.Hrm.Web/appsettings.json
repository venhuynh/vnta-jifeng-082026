{
  "ConnectionStrings": {
    "Postgres": "",
    "DefaultConnection": ""
  },
  "AIIntegrationSettings": {
    "EndpointUrl": "",
    "Key": "",
    "DeploymentName": ""
  },
  "IntegrationSecurity": {
    "GatewayInbound": {
      "RequireMutualTls": false,
      "AllowedClockSkewSeconds": 300,
      "NonceTtlSeconds": 600,
      "MaxRequestBodyBytes": 1048576,
      "Keys": {}
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "LogPath": "Logs/vnta-hrm",
    "RetainedFileCountLimit": 14,
    "FileSizeLimitBytes": 104857600
  },
  "AdmsGateway": {
    "BaseUrl": "",
    "HubPath": "/hubs/adms-monitor",
    "ActivityBufferLimit": 50,
    "RawBufferLimit": 50,
    "RawPanelEventLimit": 50,
    "DeviceOfflineTimeoutSeconds": 180
  },
  "AttendanceWorkdaySummary": {
    "EnableDailyOvertimeRegistrationCheck": false
  },
  "DatabaseStartup": {
    "AutoMigrateOnStartup": false,
    "EnableSchemaGuards": false
  },
  "AllowedHosts": "*"
}

