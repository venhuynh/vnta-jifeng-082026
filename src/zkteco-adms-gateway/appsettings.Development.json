{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Information"
      }
    },
    "LogPath": "Logs/vnta-attendance-gateway",
    "RetainedFileCountLimit": 7,
    "FileSizeLimitBytes": 104857600
  },
  "ConnectionStrings": {
    "Postgres": "",
    "DefaultConnection": ""
  },
  "AttendanceGateway": {
    "ListenerPort": 8080,
    "ControlPlanePort": 5005,
    "AutoStartTcpListener": true,
    "RawCommunicationLogEnabled": true,
    "RawCommunicationLogPath": "Logs/vnta-attendance-gateway-raw",
    "RealtimeRawBodyMaxLength": 4096,
    "RealtimeForwardQueueCapacity": 2048
  },
  "CoreApi": {
    "Enabled": false,
    "BaseUrl": "",
    "AttendanceEndpoint": "/api/integration/attendance-gateway/attendance",
    "SystemLogEndpoint": "/api/integration/attendance-gateway/system-logs",
    "RealtimeEndpoint": "/api/integration/adms/realtime/events"
  },
  "FrontendCors": {
    "AllowPrivateNetworkOrigins": true,
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:4173",
      "http://127.0.0.1:4173",
      "http://192.168.1.199:5137"
    ]
  }
}

